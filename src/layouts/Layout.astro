---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarCompanion from '../components/StarCompanion.astro';
import Starfield from '../components/Starfield.astro';

interface Props {
  title?: string;
  description?: string;
  route?: string;
}

const {
  title = 'Astrmira · 幻梦星芒 — 于未知处求索，向星芒间开拓',
  description = 'Astrmira（幻梦星芒）是一家偏研究型企业，研究方向涵盖数据库、检索、向量、量化、后训练与数学，并探索数据系统、Agent 平台与科研合作。',
  route = 'home'
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090c12" />
    <meta name="robots" content="index, follow" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64," />
    <title>{title}</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Astrmira",
        "alternateName": "幻梦星芒",
        "url": "https://astrmira-web.pages.dev",
        "description": "Astrmira（幻梦星芒）是一家偏研究型企业，研究方向涵盖数据库、检索、向量、量化、后训练与数学，并探索数据系统、Agent 平台与科研合作。"
      }
    </script>
  </head>
  <body>
    <Starfield />
    <Header currentRoute={route} />
    <StarCompanion />
    <main id="main" class="site-main" data-route={route} tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/astrmira.js"></script>
  </body>
</html>
