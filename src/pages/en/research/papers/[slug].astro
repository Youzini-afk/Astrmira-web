---
import Layout from '../../../../layouts/Layout.astro';
import PaperArtwork from '../../../../components/PaperArtwork.astro';
import PaperCard from '../../../../components/PaperCard.astro';
import { papers, paperEnglish, arxivUrl, type Paper } from '../../../../data/papers';

export function getStaticPaths() {
  return papers.map(paper => ({ params: { slug: paper.slug }, props: { paper } }));
}
interface Props { paper: Paper }
const { paper } = Astro.props;
const copy = paperEnglish[paper.slug];
const related = paper.related.map(slug => papers.find(item => item.slug === slug)).filter(Boolean) as Paper[];
const pdf = `https://arxiv.org/pdf/${paper.arxiv}${paper.version}`;
---

<Layout locale="en" title={`${paper.title} — Astrmira Research`} description={copy.summary} route={`research/papers/${paper.slug}`}>
  <div class="wrap">
    <section class="page-title paper-title">
      <div class="breadcrumb"><a href="/en/" data-route="home">Home</a><span>/</span><a href="/en/research/" data-route="research">Research</a><span>/</span><span>{paper.arxiv}</span></div>
      <p class="eyebrow">{paper.category} / ARXIV:{paper.arxiv}</p>
      <h1>{paper.title}</h1>
      <p class="paper-lede">{copy.summary}</p>
      <div class="product-actions"><a class="button button-primary" href={arxivUrl(paper)} target="_blank" rel="noopener noreferrer">Read on arXiv <span class="arrow">↗</span></a><a class="text-link" href={pdf} target="_blank" rel="noopener noreferrer">Open versioned PDF <span class="arrow">↗</span></a></div>
    </section>
    <article class="article-layout">
      <aside class="article-aside">
        <p class="eyebrow">PAPER DETAILS</p>
        <dl class="paper-meta"><dt>Authors</dt><dd>{paper.authors.join(', ')}</dd><dt>First submitted</dt><dd><time datetime={paper.submitted}>{paper.submitted}</time></dd><dt>Latest revision</dt><dd><time datetime={paper.updated}>{paper.updated}</time></dd><dt>Public version</dt><dd>arXiv {paper.arxiv}{paper.version}</dd></dl>
        <div class="topic-list">{copy.tags.map(tag => <span class="tag">{tag}</span>)}</div>
      </aside>
      <div class="article-content">
        <figure class="paper-figure"><PaperArtwork kind={paper.artwork} /><figcaption>{copy.caption}</figcaption></figure>
        {copy.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}
        <section class="source-note"><p class="eyebrow">READ AND CITE</p><h2>Continue with the original paper.</h2><p>The complete derivations, experimental setup, and results are available in the public manuscript.</p><p><a class="text-link" href={arxivUrl(paper)} target="_blank" rel="noopener noreferrer">Abstract and version history ↗</a><br /><a class="text-link" href={pdf} target="_blank" rel="noopener noreferrer">Full paper PDF ↗</a></p></section>
      </div>
    </article>
    {related.length > 0 && <section class="related-papers"><p class="eyebrow">RELATED PAPERS</p><div class="related-grid">{related.map(item => <PaperCard paper={item} locale="en" />)}</div></section>}
  </div>
</Layout>

<style>
  .paper-title h1 { max-width: 1100px; font: 400 clamp(36px, 5vw, 69px)/1.12 var(--serif); letter-spacing: -.025em; text-wrap: balance; }
  .paper-lede { max-width: 900px; margin-top: 25px; }
  .product-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px 32px; margin-top: 30px; }
  .paper-meta { margin: 22px 0 26px; }
  .paper-meta dt { margin-top: 17px; color: var(--faint); font: 9px var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .paper-meta dd { margin: 6px 0 0; color: var(--muted); font-size: 12px; line-height: 1.75; }
  .paper-figure { margin: 0 0 48px; padding: 18px 22px 22px; border: 1px solid var(--line); background: #10162080; }
  .paper-figure :global(svg) { width: min(100%, 620px); margin-inline: auto; }
  .paper-figure figcaption { margin-top: 12px; color: var(--muted); font-size: 12px; text-align: center; }
  .article-content section + section { margin-top: 48px; }
  .source-note { margin-top: 58px; padding-top: 30px; border-top: 1px solid var(--line); }
  .source-note .eyebrow { color: var(--gold); }
  .related-papers { padding: 20px 0 95px; border-top: 1px solid var(--line); }
  .related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; margin-top: 25px; }
  @media(max-width:720px){.related-grid{grid-template-columns:1fr}.paper-figure{padding:12px 14px 20px}}
</style>
