---
import Layout from '../../layouts/Layout.astro';
import InfosArtwork from '../../components/InfosArtwork.astro';

const repository = 'https://github.com/YoKONCy/infOS';
const steamPage = 'https://store.steampowered.com/app/4457100';
---

<Layout
  title="infOS · AI 伙伴运行时 — Astrmira 幻梦星芒"
  description="infOS 是面向 AI 伙伴的开源 Agent 运行时，以长期记忆、上下文编译和可扩展工具体系连接桌面互动与任务执行，为 PeroperoChat 提供运行基础。"
  route="projects/agent-platform"
>
  <div class="wrap">
    <section class="page-title">
      <div class="breadcrumb">
        <a href="/" data-route="home">首页</a><span>/</span>
        <a href="/projects/" data-route="projects">Projects</a><span>/</span>
        <span>infOS</span>
      </div>
      <p class="eyebrow">INFOS / AGENT RUNTIME</p>
      <h1>infOS</h1>
      <p class="product-tagline">让记忆延续，<br>让陪伴进入日常。</p>
      <p>一个以主 Agent 为中心的 AI 伙伴运行时，统一组织人格、长期记忆、工作区、会话与工具能力。infOS 为 PeroperoChat 提供运行基础，让桌面互动、持续对话和任务执行相互连接。</p>
      <div class="product-actions">
        <a class="button button-primary" href={repository} target="_blank" rel="noopener noreferrer">
          在 GitHub 查看 <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={repository + '#readme'} target="_blank" rel="noopener noreferrer">
          阅读项目文档 <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <article class="article-layout">
      <aside class="article-aside">
        <p class="eyebrow">OPEN SOURCE</p>
        <p>AI 伙伴运行时<br>Apache-2.0 开源许可</p>
        <div class="topic-list">
          <span class="tag">TypeScript</span><span class="tag">Rust</span>
          <span class="tag">Electron</span><span class="tag">Docker</span>
        </div>
      </aside>

      <div class="article-content">
        <h2>从一次对话，到持续相处。</h2>
        <p>一个能够持续相处的 AI 伙伴，需要记得经历过的事，也需要知道当下正在做什么。infOS 围绕同一个 Agent 组织人格、记忆、上下文与能力，让不同会话和使用场景有各自清晰的资源边界。</p>

        <figure class="infos-model">
          <InfosArtwork decorative={false} />
          <figcaption>让人格、记忆、上下文与工具，在同一个运行时中协同。</figcaption>
        </figure>

        <h2>记得住，也能把事情做下去。</h2>
        <div class="product-features">
          <section>
            <p class="eyebrow">MEMORY</p>
            <h3>把共同经历沉淀为记忆</h3>
            <p>将对话整理为结构化事件，保留时间、人物和来源。结合语义检索与关系关联，在新的对话里找回相关经历。</p>
          </section>
          <section>
            <p class="eyebrow">CONTEXT</p>
            <h3>有依据地组织每轮上下文</h3>
            <p>由后端统一整理人格、近期消息、检索记忆与可用工具，并记录本轮使用了哪些资源，让模型输入能够追溯。</p>
          </section>
          <section>
            <p class="eyebrow">ACTION</p>
            <h3>将意图转成可执行步骤</h3>
            <p>NIT 工具协议支持条件、循环、并行和错误处理，用来编排多步操作；能力门控按角色和会话场景管理工具权限。</p>
          </section>
          <section>
            <p class="eyebrow">EXTENSION</p>
            <h3>持续扩展伙伴的能力</h3>
            <p>通过技能、工具与钩子添加行为和功能，也可以接入 MCP 工具服务，让不同应用围绕运行时扩展。</p>
          </section>
        </div>

        <h2>同一内核，连接不同场景。</h2>
        <p>infOS 采用 TypeScript 全栈架构，结合 Hono 后端、Vue 界面与 Electron 桌面端，并通过 Rust 承载部分核心算法。后端也可以独立运行或通过 Docker 部署，供不同客户端接入。</p>
        <p>记忆层使用 <a class="inline-project-link" href="/projects/data-systems/" data-route="projects/data-systems">TriviumDB</a> 连接向量检索、事件与关系。桌面、陪伴和社交会话围绕同一个 Agent 协作，各自的上下文与能力由场景配置决定。</p>

        <section class="product-application">
          <p class="eyebrow">POWERING PEROPEROCHAT</p>
          <h2>萌动链接：PeroperoChat</h2>
          <p>PeroperoChat 是 infOS 面向桌面陪伴的应用形态，将 3D 角色、自定义人设、对话与长期记忆组织成日常互动。运行时提供记忆和工具能力，客户端把它们带到用户身边。</p>
          <a class="text-link" href={steamPage} target="_blank" rel="noopener noreferrer">
            查看 Steam 页面 <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </section>

        <div class="product-links">
          <a class="button" href={repository} target="_blank" rel="noopener noreferrer">
            探索 infOS <span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/collaborate/" data-route="collaborate">
            讨论应用与合作 <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .page-title .product-tagline { margin-top: 28px; color: var(--text); font-size: clamp(21px, 2.3vw, 30px); line-height: 1.6; }
  .product-tagline + p { margin-top: 18px; }
  .product-actions, .product-links { display: flex; flex-wrap: wrap; align-items: center; gap: 22px 32px; margin-top: 30px; }
  .infos-model { margin: 34px 0 48px; padding: 20px 24px 24px; border: 1px solid var(--line); background: #10162080; }
  .infos-model :global(svg) { width: min(100%, 490px); margin-inline: auto; }
  .infos-model figcaption { color: var(--muted); font-size: 12px; text-align: center; margin-top: 12px; }
  .product-features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; margin: 24px 0 42px; }
  .product-features section { padding: 24px 0; border-top: 1px solid var(--line); }
  .product-features .eyebrow, .product-application .eyebrow { color: var(--gold); font-size: 9px; }
  .product-features h3 { margin: 12px 0 10px; font-size: 18px; }
  .product-features p { margin: 0; }
  .inline-project-link { color: var(--gold); border-bottom: 1px solid var(--line); }
  .product-application { margin-top: 36px; padding: 28px; border: 1px solid var(--line); background: #10162080; }
  .product-application h2 { margin-top: 12px; }
  .product-application .text-link { margin-top: 20px; color: var(--gold); }
  .product-links { padding-top: 24px; border-top: 1px solid var(--line); }
  .product-links .button { margin-top: 0; }
  @media(max-width: 720px) {
    .product-features { grid-template-columns: 1fr; }
    .infos-model { padding: 12px 14px 20px; }
    .infos-model figcaption { font-size: 11px; }
    .product-application { padding: 22px; }
    .product-application h2 { font-size: 21px; }
  }
</style>
