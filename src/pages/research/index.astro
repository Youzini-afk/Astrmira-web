---
import Layout from '../../layouts/Layout.astro';
import PaperCard from '../../components/PaperCard.astro';
import { papers } from '../../data/papers';
---

<Layout title="Research · 研究与论文 — Astrmira 幻梦星芒" description="阅读 Astrmira 在不同领域的研究论文，了解我们关注的问题、提出的方法与新的发现。" route="research">
  <div class="wrap">
    <section class="page-title">
      <p class="eyebrow">RESEARCH / PUBLICATIONS</p>
      <h1>Questions.<br /><em>Evidence. Progress.</em></h1>
      <p>我们的研究从值得追问的问题出发，在不同领域探索新的理解与方法。这里汇集论文与研究进展，连接每一次发现和由此展开的新问题。</p>
    </section>

    <section class="directory-content" data-research-directory aria-label="研究论文">
      <div class="directory-toolbar">
        <div class="filters" aria-label="筛选论文">
          <button class="filter-button" data-research-filter="all" aria-pressed="true">全部论文</button>
          <button class="filter-button" data-research-filter="vectors" aria-pressed="false">向量检索</button>
          <button class="filter-button" data-research-filter="llms" aria-pressed="false">大模型量化</button>
          <button class="filter-button" data-research-filter="theory" aria-pressed="false">表示与理论</button>
        </div>
        <input class="research-search" data-research-search placeholder="搜索论文、作者或关键词…" type="search" aria-label="搜索论文、作者或关键词" />
      </div>
      <div class="publication-grid">
        {papers.map(paper => <PaperCard paper={paper} headingLevel="h2" />)}
      </div>
      <p class="empty-search" data-empty-search hidden>没有找到匹配的论文，试试其他关键词或研究方向。</p>
      <p class="publication-count" data-research-count aria-live="polite">{papers.length} 篇论文</p>
    </section>

    <section class="research-contact">
      <p>有值得一起追问的问题？</p>
      <a href="/collaborate/" data-route="collaborate" class="text-link">与我们交流 <span class="arrow" aria-hidden="true">↗</span></a>
    </section>
  </div>
</Layout>

