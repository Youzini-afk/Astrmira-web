---
import Layout from '../layouts/Layout.astro';
---

<Layout title="项目与业务方向 — Astrmira 幻梦星芒" currentPath="/projects">
  <div class="wrap page-container">
    <div class="page-header">
      <div class="breadcrumb">
        <a href="/">Astrmira</a>
        <span class="sep">/</span>
        <span>Projects</span>
      </div>

      <div class="eyebrow">OUR INITIATIVES & SYSTEMS</div>
      <h1 class="page-title">把研究，写进现实。</h1>
      <p class="page-lead">
        不把技术止步于理论推演。我们将底层数理结构转化为高可用、高可靠的工程系统，涵盖海量数据基础设施、自主智能 Agent 体系以及学术联合攻关。
      </p>
    </div>

    <!-- Direction Filters -->
    <div class="directory-toolbar">
      <div class="filters" role="tablist">
        <button class="filter-btn is-active" data-filter="all">全部方向 (3)</button>
        <button class="filter-btn" data-filter="data">数据系统 (1)</button>
        <button class="filter-btn" data-filter="agent">Agent 平台 (1)</button>
        <button class="filter-btn" data-filter="joint">联合研究 (1)</button>
      </div>
      <span class="status-note">状态：拟开展与原型验证阶段</span>
    </div>

    <!-- Projects List -->
    <div class="projects-list">
      <!-- Item 1 -->
      <section class="project-detail-card" data-category="data">
        <div class="detail-header">
          <div class="eyebrow">SYSTEMS // 01</div>
          <span class="status-tag">RESEARCH PROTOTYPE · 拟开展</span>
        </div>
        <h2 class="detail-title">高维数据与向量检索系统</h2>
        <p class="detail-lead">
          以千万至十亿级超大规模向量检索为核心，研发软硬件协同的高吞吐索引与密集向量存储底座。
        </p>

        <div class="detail-grid">
          <div class="detail-col">
            <h3>拟解决的核心问题</h3>
            <p>传统向量数据库在高并发更新与超高维多模态场景下面临内存膨胀、图拓扑退化与长尾延迟恶化。我们需要在超低延迟下保证高召回率。</p>
          </div>
          <div class="detail-col">
            <h3>核心技术架构</h3>
            <ul>
              <li><strong>分层近邻拓扑索引 (Hierarchical Graph Indexing)</strong>：兼顾写入吞吐与检索深度</li>
              <li><strong>高维自适应量化 (Product & Scalar Quantization)</strong>：高达 8x ~ 16x 的内存压缩比</li>
              <li><strong>混合非欧流形度量</strong>：针对双曲空间与球面语义特征优化的专用算子</li>
            </ul>
          </div>
        </div>

        <div class="detail-footer">
          <div class="tags">
            <span class="tag">VECTOR ANN</span>
            <span class="tag">STORAGE ENGINE</span>
            <span class="tag">TOPOLOGY</span>
          </div>
          <a href="/contact" class="text-link">探讨技术合作 <span class="arrow">&nearr;</span></a>
        </div>
      </section>

      <!-- Item 2 -->
      <section class="project-detail-card" data-category="agent">
        <div class="detail-header">
          <div class="eyebrow">INTELLIGENCE // 02</div>
          <span class="status-tag">ACTIVE DESIGN · 拟开展</span>
        </div>
        <h2 class="detail-title">自主认知与闭环 Agent 平台</h2>
        <p class="detail-lead">
          面向办公协同、代码编写、科学实验推演与自适应学习，构建具备确定性验证能力的 Agent 编排与行动网络。
        </p>

        <div class="detail-grid">
          <div class="detail-col">
            <h3>四大核心落地场景</h3>
            <ul>
              <li><strong>Coding Agent</strong>：工程级多文件理解、依赖分析与自动化沙箱测试验证</li>
              <li><strong>科研推演助手</strong>：文献精读、假说生成、符号数学推导与实验数据整理</li>
              <li><strong>智能办公中枢</strong>：跨应用任务路由、长程工作流拆解与确定性交付</li>
              <li><strong>教育协同伴随</strong>：概念拓扑引导与因材施教的互动式推演</li>
            </ul>
          </div>
          <div class="detail-col">
            <h3>架构保障与确定性</h3>
            <p>摒弃盲目的单次生成，引入<strong>形式化反思（Formal Reflection）</strong>与<strong>沙箱环境双向反馈</strong>，确保 Agent 的每一步工具调用与系统操作均可验证、可撤销、可回溯。</p>
          </div>
        </div>

        <div class="detail-footer">
          <div class="tags">
            <span class="tag">MULTI-AGENT</span>
            <span class="tag">CODE REASONING</span>
            <span class="tag">SANDBOX</span>
          </div>
          <a href="/contact" class="text-link">探讨技术合作 <span class="arrow">&nearr;</span></a>
        </div>
      </section>

      <!-- Item 3 -->
      <section class="project-detail-card" data-category="joint">
        <div class="detail-header">
          <div class="eyebrow">DISCOVERY // 03</div>
          <span class="status-tag">OPEN COLLABORATION · 联合推进</span>
        </div>
        <h2 class="detail-title">前沿数理与高校联合研究中心</h2>
        <p class="detail-lead">
          与全球顶尖高校与先锋学者展开深度合作，聚焦损失曲面几何、非凸优化理论与模型后训练（Post-training）对齐。
        </p>

        <div class="detail-grid">
          <div class="detail-col">
            <h3>联合研究范式</h3>
            <p>我们提供算力底座、真实系统实验环境与工程验证平台，联合顶尖学者从最本质的第一性原理出发，共同开辟新的问题空间并发表顶会研究。</p>
          </div>
          <div class="detail-col">
            <h3>当前重点推进方向</h3>
            <ul>
              <li>超高维损失平坦极小值与泛化边界理论</li>
              <li>基于可验证奖励（Verifiable Rewards）的强化学习后训练</li>
              <li>符号逻辑与连续神经网络的深层表征融合</li>
            </ul>
          </div>
        </div>

        <div class="detail-footer">
          <div class="tags">
            <span class="tag">THEORETICAL ML</span>
            <span class="tag">OPTIMIZATION</span>
            <span class="tag">JOINT LAB</span>
          </div>
          <a href="/contact" class="text-link">申请联合课题 <span class="arrow">&nearr;</span></a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: 60px;
    padding-bottom: 110px;
  }

  .breadcrumb {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  .breadcrumb .sep {
    color: var(--line);
  }

  .page-title {
    font-family: var(--serif);
    font-size: clamp(38px, 4.8vw, 56px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 12px 0 18px;
  }

  .page-lead {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 2;
    max-width: 720px;
    margin-bottom: 48px;
  }

  .directory-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-block: 1px solid var(--line);
    padding-block: 16px;
    margin-bottom: 40px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .filters {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 7px 16px;
    border: 1px solid transparent;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    transition: all 0.2s;
  }

  .filter-btn:hover {
    color: var(--text);
  }

  .filter-btn.is-active {
    border-color: var(--line);
    background: rgba(214, 184, 129, 0.08);
    color: var(--gold);
  }

  .status-note {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--faint);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .project-detail-card {
    border: 1px solid var(--line);
    background: rgba(16, 20, 28, 0.65);
    backdrop-filter: blur(16px);
    padding: 36px 36px 30px;
    transition: border-color 0.3s;
  }

  .project-detail-card:hover {
    border-color: rgba(214, 184, 129, 0.3);
  }

  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .status-tag {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--gold);
    border: 1px solid rgba(214, 184, 129, 0.25);
    padding: 3px 8px;
  }

  .detail-title {
    font-size: clamp(24px, 2.6vw, 32px);
    letter-spacing: 0.02em;
    margin-bottom: 12px;
  }

  .detail-lead {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.95;
    max-width: 800px;
    margin-bottom: 28px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    margin-bottom: 24px;
  }

  .detail-col h3 {
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--text);
    margin-bottom: 12px;
  }

  .detail-col p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.95;
  }

  .detail-col ul {
    list-style: none;
    font-size: 13px;
    color: var(--muted);
    line-height: 2;
  }

  .detail-col ul li::before {
    content: "— ";
    color: var(--gold);
  }

  .detail-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 20px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .tags {
    display: flex;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .project-detail-card {
      padding: 24px 20px;
    }
    .detail-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-detail-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      filterBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
