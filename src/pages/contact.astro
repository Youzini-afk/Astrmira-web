---
import Layout from '../layouts/Layout.astro';
---

<Layout title="开启合作与学术对话 — Astrmira 幻梦星芒" currentPath="/contact">
  <div class="wrap page-container">
    <div class="page-header">
      <div class="breadcrumb">
        <a href="/">Astrmira</a>
        <span class="sep">/</span>
        <span>Contact</span>
      </div>

      <div class="eyebrow">START A CONVERSATION</div>
      <h1 class="page-title">开启一次深度的学术与技术对话。</h1>
      <p class="page-lead">
        无论你是寻求理论突破的高校学者、需要高并发向量底座与自主 Agent 支撑的技术团队，还是渴望加入深空求索行列的工程师，欢迎与我们联络。
      </p>
    </div>

    <div class="contact-grid">
      <!-- Left: Cooperation Channels -->
      <div class="contact-channels">
        <div class="eyebrow">COOPERATION CHANNELS</div>
        <h2>主要合作方向</h2>

        <div class="channel-item">
          <h3>01 / 学术与高校联合研究</h3>
          <p>针对损失曲面几何、非凸优化、后训练强化学习对齐等课题，提供工程算力与系统实验平台，联合攻关并产出顶会论文。</p>
        </div>

        <div class="channel-item">
          <h3>02 / 数据系统与向量底层共建</h3>
          <p>针对海量非结构化数据、大模型知识库检索与复杂拓扑索引场景，探索高性能专有存储引擎与检索服务。</p>
        </div>

        <div class="channel-item">
          <h3>03 / 企业级自主 Agent 场景落地</h3>
          <p>针对 Coding 研发自动化、科研助手推演与复杂办公流程，部署具备确定性闭环反思能力的智能体工作流。</p>
        </div>

        <div class="channel-item">
          <h3>04 / 研究员与系统工程师加入</h3>
          <p>寻找在分布式存储、向量数据库、Agent 规划、数学优化与机器学习系统领域有深刻理解的伙伴。</p>
        </div>
      </div>

      <!-- Right: Functional Local Brief Generator Form -->
      <div class="contact-form-wrap">
        <form class="contact-form" id="brief-form">
          <div class="eyebrow">INQUIRY FORM</div>
          <h3>生成合作意向简报</h3>

          <div class="field">
            <label for="form-name">您的称呼 / Name</label>
            <input type="text" id="form-name" name="name" placeholder="例如：李研究员 / 某实验室负责人" required>
          </div>

          <div class="field">
            <label for="form-org">机构 / 团队 / Organization</label>
            <input type="text" id="form-org" name="org" placeholder="例如：某大学人工智能实验室 / 某科技企业" required>
          </div>

          <div class="field">
            <label for="form-area">关注的方向 / Direction</label>
            <select id="form-area" name="area">
              <option value="学术与高校联合研究">学术与高校联合研究 (Theoretical ML & Joint Lab)</option>
              <option value="数据系统与向量底层共建">数据系统与向量底层共建 (Vector Systems & ANN)</option>
              <option value="企业级自主 Agent 落地">企业级自主 Agent 落地 (Autonomous Agent Platform)</option>
              <option value="研究员与工程师职位咨询">研究员与工程师职位咨询 (Career & Fellowship)</option>
            </select>
          </div>

          <div class="field">
            <label for="form-msg">问题、目标或课题描述 / Proposal Details</label>
            <textarea id="form-msg" name="message" placeholder="请简要描述您关注的核心问题、预期目标或合作愿景..." required></textarea>
          </div>

          <button type="submit" class="button button-primary">
            生成意向简报并复制 <span class="arrow">&nearr;</span>
          </button>
        </form>

        <!-- Brief result display -->
        <div class="brief-result" id="brief-result" hidden>
          <div class="eyebrow">GENERATED BRIEF</div>
          <h4>简报已在本地生成并已复制到剪贴板</h4>
          <pre id="brief-content"></pre>
          <div class="brief-actions">
            <button class="button button-quiet" id="btn-copy-brief">重新复制文本</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: 60px;
    padding-bottom: 110px;
  }

  .breadcrumb {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  .breadcrumb .sep {
    color: var(--line);
  }

  .page-title {
    font-family: var(--serif);
    font-size: clamp(36px, 4.5vw, 54px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 12px 0 18px;
  }

  .page-lead {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 2;
    max-width: 760px;
    margin-bottom: 50px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 70px;
    border-top: 1px solid var(--line);
    padding-top: 40px;
  }

  .contact-channels h2 {
    font-family: var(--serif);
    font-size: 26px;
    margin: 14px 0 30px;
  }

  .channel-item {
    border-bottom: 1px solid var(--line);
    padding-bottom: 22px;
    margin-bottom: 22px;
  }

  .channel-item h3 {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .channel-item p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.95;
  }

  .contact-form-wrap {
    background: rgba(16, 20, 28, 0.7);
    border: 1px solid var(--line);
    padding: 36px 40px;
  }

  .contact-form h3 {
    font-size: 22px;
    margin: 10px 0 24px;
  }

  .field {
    margin-bottom: 22px;
  }

  .field label {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .field input, .field select, .field textarea {
    width: 100%;
    background: #090c12;
    border: 1px solid var(--line);
    color: var(--text);
    padding: 12px 14px;
    font-size: 13px;
    outline: none;
    font-family: inherit;
    transition: border-color 0.2s;
  }

  .field input:focus, .field select:focus, .field textarea:focus {
    border-color: var(--gold);
  }

  .field textarea {
    min-height: 120px;
    resize: vertical;
  }

  .brief-result {
    margin-top: 30px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }

  .brief-result h4 {
    font-size: 14px;
    color: var(--gold);
    margin: 8px 0 16px;
  }

  .brief-result pre {
    background: #090c12;
    border: 1px solid var(--line);
    padding: 18px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text);
    white-space: pre-wrap;
    line-height: 1.8;
  }

  .brief-actions {
    margin-top: 16px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .contact-form-wrap {
      padding: 26px 20px;
    }
  }
</style>

<script>
  const form = document.getElementById('brief-form') as HTMLFormElement;
  const resultBox = document.getElementById('brief-result');
  const briefPre = document.getElementById('brief-content');
  const copyBtn = document.getElementById('btn-copy-brief');

  let currentBriefText = '';

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = formData.get('name') || '';
      const org = formData.get('org') || '';
      const area = formData.get('area') || '';
      const msg = formData.get('message') || '';

      currentBriefText = `Astrmira · 合作意向简报\n\n称呼：${name}\n机构 / 团队：${org}\n意向方向：${area}\n\n问题与课题描述：\n${msg}\n\n——\n发送至：contact@astrmira.com（或官方指定沟通渠道）\n时间：${new Date().toLocaleDateString('zh-CN')}`;

      if (briefPre) briefPre.textContent = currentBriefText;
      if (resultBox) resultBox.hidden = false;

      navigator.clipboard.writeText(currentBriefText).then(() => {
        const btn = form.querySelector('button[type="submit"]');
        if (btn) {
          const orig = btn.innerHTML;
          btn.innerHTML = '已生成并复制到剪贴板 ✦';
          setTimeout(() => { btn.innerHTML = orig; }, 3000);
        }
      });
    });
  }

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      if (currentBriefText) {
        navigator.clipboard.writeText(currentBriefText).then(() => {
          copyBtn.textContent = '已重新复制 ✦';
          setTimeout(() => { copyBtn.textContent = '重新复制文本'; }, 2000);
        });
      }
    });
  }
</script>
