---
import Layout from '../layouts/Layout.astro';
---

<Layout title="研究方向与学术成果 — Astrmira 幻梦星芒" currentPath="/research">
  <div class="wrap page-container">
    <div class="page-header">
      <div class="breadcrumb">
        <a href="/">Astrmira</a>
        <span class="sep">/</span>
        <span>Research</span>
      </div>

      <div class="eyebrow">CONTRIBUTIONS & PAPERS</div>
      <h1 class="page-title">探索，抵达可验证的真实。</h1>
      <p class="page-lead">
        我们在数据库、高维检索、向量量化、模型后训练与非凸优化数学深水区求索。每一项研究均坚持从第一性原理出发，给出明确的问题定义、实验证据与可复现边界。
      </p>
    </div>

    <!-- Search & Filter Bar -->
    <div class="directory-toolbar">
      <div class="filters">
        <button class="filter-btn is-active" data-topic="all">全部方向 (4)</button>
        <button class="filter-btn" data-topic="db">数据库与检索</button>
        <button class="filter-btn" data-topic="quant">量化表示</button>
        <button class="filter-btn" data-topic="agent">Agent 闭环</button>
        <button class="filter-btn" data-topic="math">数理优化</button>
      </div>

      <div class="search-wrap">
        <input type="search" id="research-search-input" placeholder="输入关键词搜索研究论文..." class="search-input">
      </div>
    </div>

    <!-- Research List -->
    <div class="research-list" id="research-items">
      <!-- Item 1 -->
      <article class="research-card" data-topic="db">
        <div class="card-meta">
          <span class="eyebrow">RESEARCH FOCUS // 01</span>
          <span class="year-badge">TOPOLOGY & RETRIEVAL</span>
        </div>
        <h2 class="card-paper-title">大规模向量检索中的分层拓扑与非欧度量空间优化</h2>
        <p class="paper-authors">Astrmira Research Labs · Systems Group</p>
        <p class="card-paper-abstract">
          针对十亿级高维语义嵌入在复杂动态增量更新时图拓扑退化的问题，提出了一种结合局部黎曼曲率估计的分层自适应导航图架构，在相同召回率下将遍历跳数降低 34%，长尾 P99 延迟稳定在亚毫秒级。
        </p>
        <div class="card-paper-footer">
          <div class="tags">
            <span class="tag">ANN GRAPH</span>
            <span class="tag">NON-EUCLIDEAN</span>
            <span class="tag">SUB-MS LATENCY</span>
          </div>
          <div class="paper-actions">
            <button class="cite-btn" data-cite="astrmira2025topology">复制 BibTeX</button>
            <a href="#projects" class="text-link">查看落地系统 <span class="arrow">&nearr;</span></a>
          </div>
        </div>
      </article>

      <!-- Item 2 -->
      <article class="research-card" data-topic="quant">
        <div class="card-meta">
          <span class="eyebrow">RESEARCH FOCUS // 02</span>
          <span class="year-badge">QUANTIZATION & CODEBOOKS</span>
        </div>
        <h2 class="card-paper-title">低比特自适应残差量化在密集语义表征中的渐进逼近理论</h2>
        <p class="paper-authors">Astrmira Research Labs · Representations</p>
        <p class="card-paper-abstract">
          论证了极端非各向同性高维空间中量化误差传播的非凸上界，提出了一种兼顾聚类质心正交性与稀疏残差补偿的二阶量化编码算法。在 4-bit 乃至 2-bit 压缩比下，保持与原始 32 位浮点相当的余弦度量精度。
        </p>
        <div class="card-paper-footer">
          <div class="tags">
            <span class="tag">4-BIT COMPRESSION</span>
            <span class="tag">RESIDUAL CODEBOOK</span>
            <span class="tag">INFORMATION THEORY</span>
          </div>
          <div class="paper-actions">
            <button class="cite-btn" data-cite="astrmira2025quant">复制 BibTeX</button>
            <a href="#projects" class="text-link">查看落地系统 <span class="arrow">&nearr;</span></a>
          </div>
        </div>
      </article>

      <!-- Item 3 -->
      <article class="research-card" data-topic="agent">
        <div class="card-meta">
          <span class="eyebrow">RESEARCH FOCUS // 03</span>
          <span class="year-badge">COGNITIVE SYSTEMS</span>
        </div>
        <h2 class="card-paper-title">面向长程推理任务的多 Agent 形式化反思与可验证闭环</h2>
        <p class="paper-authors">Astrmira Research Labs · Autonomous Agents</p>
        <p class="card-paper-abstract">
          面对复杂代码生成与长程推演中 Agent 级联幻觉与死循环困境，构建了基于形式化状态机检查的双轨决策框架。通过将符号沙箱执行结果与自然语言反思轨迹强耦合，实现了可证明的单步回溯与确定性收敛。
        </p>
        <div class="card-paper-footer">
          <div class="tags">
            <span class="tag">FORMAL VERIFICATION</span>
            <span class="tag">AGENT SANDBOX</span>
            <span class="tag">SELF-REFLECTION</span>
          </div>
          <div class="paper-actions">
            <button class="cite-btn" data-cite="astrmira2025agent">复制 BibTeX</button>
            <a href="#projects" class="text-link">查看落地系统 <span class="arrow">&nearr;</span></a>
          </div>
        </div>
      </article>

      <!-- Item 4 -->
      <article class="research-card" data-topic="math">
        <div class="card-meta">
          <span class="eyebrow">RESEARCH FOCUS // 04</span>
          <span class="year-badge">OPTIMIZATION & ALIGNMENT</span>
        </div>
        <h2 class="card-paper-title">高维神经网络损失曲面的平坦极小值与后训练泛化几何</h2>
        <p class="paper-authors">Astrmira Research Labs · Mathematical Foundations</p>
        <p class="card-paper-abstract">
          深入研究后训练（Post-training）阶段参数空间损失景观（Loss Landscape）的局部曲率与鲁棒性关联。给出了基于锐度感知最小化（SAM）的自适应学习率下界，显著提升模型在分布外对抗样本下的泛化能力。
        </p>
        <div class="card-paper-footer">
          <div class="tags">
            <span class="tag">LOSS LANDSCAPES</span>
            <span class="tag">POST-TRAINING</span>
            <span class="tag">GENERALIZATION</span>
          </div>
          <div class="paper-actions">
            <button class="cite-btn" data-cite="astrmira2025math">复制 BibTeX</button>
            <a href="/contact" class="text-link">探讨理论合作 <span class="arrow">&nearr;</span></a>
          </div>
        </div>
      </article>
    </div>

    <!-- Archive & Academic Note -->
    <div class="academic-note-box">
      <div>
        <div class="eyebrow">RESEARCH INTEGRITY</div>
        <h3>恪守学术真实与严谨边界</h3>
      </div>
      <p>
        Astrmira 的公开研究均遵循真实可复现原则。所有预印本论文、基准测试代码与数理推导附录将通过开源仓库与正规学术渠道公开。欢迎学术机构与同行学者与我们展开批判性质疑与深度合作。
      </p>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: 60px;
    padding-bottom: 110px;
  }

  .breadcrumb {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  .breadcrumb .sep {
    color: var(--line);
  }

  .page-title {
    font-family: var(--serif);
    font-size: clamp(38px, 4.8vw, 56px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 12px 0 18px;
  }

  .page-lead {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 2;
    max-width: 720px;
    margin-bottom: 48px;
  }

  .directory-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-block: 1px solid var(--line);
    padding-block: 16px;
    margin-bottom: 40px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 7px 14px;
    border: 1px solid transparent;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    transition: all 0.2s;
  }

  .filter-btn:hover {
    color: var(--text);
  }

  .filter-btn.is-active {
    border-color: var(--line);
    background: rgba(214, 184, 129, 0.08);
    color: var(--gold);
  }

  .search-input {
    background: #10141c;
    border: 1px solid var(--line);
    color: var(--text);
    padding: 8px 14px;
    font-size: 12px;
    width: 260px;
    outline: none;
    font-family: inherit;
  }

  .search-input:focus {
    border-color: var(--gold);
  }

  .research-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .research-card {
    border: 1px solid var(--line);
    background: rgba(16, 20, 28, 0.6);
    backdrop-filter: blur(16px);
    padding: 32px 36px 28px;
    transition: border-color 0.25s, transform 0.25s;
  }

  .research-card:hover {
    border-color: rgba(214, 184, 129, 0.35);
    transform: translateY(-2px);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .year-badge {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--gold);
    letter-spacing: 0.1em;
  }

  .card-paper-title {
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.4;
    letter-spacing: 0.02em;
    margin-bottom: 8px;
    font-weight: 400;
  }

  .paper-authors {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    margin-bottom: 16px;
  }

  .card-paper-abstract {
    font-size: 13px;
    color: var(--muted);
    line-height: 2;
    margin-bottom: 24px;
    max-width: 860px;
  }

  .card-paper-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 18px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .paper-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .cite-btn {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    border: 1px solid var(--line);
    padding: 4px 10px;
    transition: all 0.2s;
  }

  .cite-btn:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .academic-note-box {
    margin-top: 50px;
    background: rgba(16, 20, 28, 0.85);
    border: 1px solid var(--line);
    padding: 32px 36px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: center;
  }

  .academic-note-box h3 {
    font-size: 20px;
    margin-top: 8px;
  }

  .academic-note-box p {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 2;
  }

  @media (max-width: 768px) {
    .research-card {
      padding: 24px 20px;
    }
    .academic-note-box {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 24px 20px;
    }
    .search-input {
      width: 100%;
    }
  }
</style>

<script>
  // Filter by topic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.research-card');
  const searchInput = document.getElementById('research-search-input') as HTMLInputElement;

  function filterContent() {
    const activeBtn = document.querySelector('.filter-btn.is-active');
    const topic = activeBtn?.getAttribute('data-topic') || 'all';
    const query = (searchInput?.value || '').trim().toLowerCase();

    cards.forEach(card => {
      const cardTopic = card.getAttribute('data-topic');
      const text = card.textContent?.toLowerCase() || '';

      const matchTopic = topic === 'all' || cardTopic === topic;
      const matchQuery = !query || text.includes(query);

      if (matchTopic && matchQuery) {
        (card as HTMLElement).style.display = 'block';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      filterContent();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', filterContent);
  }

  // BibTeX Copy action
  const citeBtns = document.querySelectorAll('.cite-btn');
  citeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-cite');
      const bibtex = `@article{${key},\n  author = {Astrmira Research Labs},\n  title = {Fundamental Inquiries in Computations and Agents},\n  journal = {Astrmira Technical Report Series},\n  year = {2025}\n}`;
      navigator.clipboard.writeText(bibtex).then(() => {
        const orig = btn.textContent;
        btn.textContent = '已复制 BibTeX ✦';
        setTimeout(() => { btn.textContent = orig; }, 2000);
      });
    });
  });
</script>
