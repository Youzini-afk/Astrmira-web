---
import { LOCALES, type InternationalLocale } from '../../i18n';
import { papers } from '../../data/papers';
import { projectDetails } from '../../data/english';
import HomePage from '../../components/pages/HomePage.astro';
import ProjectDirectoryPage from '../../components/pages/ProjectDirectoryPage.astro';
import ProjectDetailPage from '../../components/pages/ProjectDetailPage.astro';
import ResearchDirectoryPage from '../../components/pages/ResearchDirectoryPage.astro';
import PaperPage from '../../components/pages/PaperPage.astro';
import PartnershipPage from '../../components/pages/PartnershipPage.astro';
import ContactPage from '../../components/ContactPage.astro';
import CareersPage from '../../components/CareersPage.astro';
import AboutPage from '../../components/AboutPage.astro';

export function getStaticPaths() {
  const paths = ['', 'about', 'projects', 'research', 'collaborate', 'contact', 'careers', 'projects/research-partnerships',
    ...Object.keys(projectDetails).map(slug => `projects/${slug}`),
    ...papers.map(paper => `research/papers/${paper.slug}`)];
  return LOCALES.filter(locale => locale.id !== 'zh-cn').flatMap(locale => paths.map(path => ({ params: { locale: locale.id, path: path || undefined }, props: { locale: locale.id, path } })));
}
interface Props { locale: InternationalLocale; path: string }
const { locale, path } = Astro.props;
const project = path.slice('projects/'.length) as keyof typeof projectDetails;
---
{path === '' && <HomePage locale={locale} />}
{path === 'about' && <AboutPage locale={locale} />}
{path === 'projects' && <ProjectDirectoryPage locale={locale} />}
{path === 'research' && <ResearchDirectoryPage locale={locale} />}
{['collaborate', 'contact'].includes(path) && <ContactPage locale={locale} />}
{path === 'careers' && <CareersPage locale={locale} />}
{path === 'projects/research-partnerships' && <PartnershipPage locale={locale} />}
{path.startsWith('projects/') && project in projectDetails && <ProjectDetailPage locale={locale} slug={project} />}
{path.startsWith('research/papers/') && <PaperPage locale={locale} slug={path.slice('research/papers/'.length)} />}
