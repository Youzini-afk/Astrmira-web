---
// ProjectSection.astro: The three core business and project pillars
---

<section class="section" id="projects">
  <div class="wrap">
    <!-- Manifesto block -->
    <div class="manifesto">
      <div class="eyebrow">
        <span class="index">01</span>
        <span>OUR PRACTICE</span>
      </div>
      <div>
        <h2 class="statement">
          探索，不止于论文。<br>
          让研究，抵达真实的世界。
        </h2>
        <p class="statement-note">
          以基础研究拓展可能，以系统构建应对问题。这是我们希望持续走下去的路。
        </p>
      </div>
    </div>

    <!-- Section Heading -->
    <div class="section-heading">
      <div>
        <div class="eyebrow">IDEAS, MADE TANGIBLE</div>
        <h3 class="section-title">把研究，写进现实。</h3>
        <p class="sub">从数据底座，到智能行动，再到开放的科研协作。</p>
      </div>
      <a href="/projects" class="text-link">
        全部项目 <span class="arrow">&nearr;</span>
      </a>
    </div>

    <!-- 3 Project Cards -->
    <div class="project-grid">
      <!-- Card 1: Data Systems -->
      <article class="project-card">
        <div class="project-art">
          <span class="art-label">SYSTEMS / 01</span>
          <span class="art-number">01</span>
          <!-- Multi-tier data indexing SVG -->
          <svg viewBox="0 0 320 220" fill="none" aria-hidden="true">
            <g opacity="0.85">
              <!-- Lower plane -->
              <polygon points="160,170 260,140 160,110 60,140" stroke="#91b9d5" stroke-width="0.8" fill="rgba(145,185,213,0.03)" stroke-dasharray="2 4"/>
              <!-- Middle plane -->
              <polygon points="160,140 260,110 160,80 60,110" stroke="#91b9d5" stroke-width="0.8" fill="rgba(145,185,213,0.05)"/>
              <!-- Top plane -->
              <polygon points="160,110 260,80 160,50 60,80" stroke="#d6b881" stroke-width="1.2" fill="rgba(214,184,129,0.08)"/>
              
              <!-- Data nodes and projections -->
              <circle cx="160" cy="80" r="3" fill="#d6b881"/>
              <circle cx="200" cy="70" r="2.5" fill="#d6b881"/>
              <circle cx="120" cy="90" r="2.5" fill="#91b9d5"/>
              <line x1="160" y1="80" x2="160" y2="140" stroke="#d6b881" stroke-width="0.8" stroke-dasharray="2 3"/>
              <line x1="200" y1="70" x2="200" y2="130" stroke="#91b9d5" stroke-width="0.8" stroke-dasharray="2 3"/>
              <circle cx="160" cy="140" r="2" fill="#d6b881"/>
              
              <!-- Point cloud to the left -->
              <circle cx="90" cy="140" r="1.5" fill="#91b9d5" opacity="0.6"/>
              <circle cx="105" cy="130" r="1.5" fill="#91b9d5" opacity="0.7"/>
              <circle cx="75" cy="145" r="1.5" fill="#91b9d5" opacity="0.5"/>
              <circle cx="115" cy="155" r="1.5" fill="#91b9d5" opacity="0.8"/>
            </g>
          </svg>
        </div>
        <div class="project-body">
          <div class="status">拟开展方向</div>
          <h4 class="card-title">数据系统</h4>
          <p class="card-desc">以数据库、向量与检索研发为起点，探索面向真实负载的数据基础设施。</p>
          <div class="project-footer">
            <span>DATABASE · VECTOR · SEARCH</span>
            <span class="arrow">&nearr;</span>
          </div>
        </div>
      </article>

      <!-- Card 2: Agent Platform -->
      <article class="project-card">
        <div class="project-art">
          <span class="art-label">INTELLIGENCE / 02</span>
          <span class="art-number">02</span>
          <!-- Agent orbital task network SVG -->
          <svg viewBox="0 0 320 220" fill="none" aria-hidden="true">
            <g opacity="0.85">
              <!-- Orbit ellipses -->
              <ellipse cx="160" cy="110" rx="95" ry="42" transform="rotate(-25 160 110)" stroke="#91b9d5" stroke-width="0.8" opacity="0.4"/>
              <ellipse cx="160" cy="110" rx="95" ry="42" transform="rotate(25 160 110)" stroke="#91b9d5" stroke-width="0.8" opacity="0.4"/>
              <ellipse cx="160" cy="110" rx="80" ry="80" stroke="#d6b881" stroke-width="0.9" stroke-dasharray="3 5" opacity="0.5"/>

              <!-- Central reasoning node -->
              <circle cx="160" cy="110" r="5" fill="#d6b881"/>
              <circle cx="160" cy="110" r="12" stroke="#d6b881" stroke-width="0.6" stroke-dasharray="2 2"/>

              <!-- Peripheral task nodes: Code, Science, Office, Learning -->
              <circle cx="225" cy="75" r="3" fill="#91b9d5"/>
              <line x1="160" y1="110" x2="225" y2="75" stroke="#91b9d5" stroke-width="0.75" stroke-dasharray="2 3"/>

              <circle cx="95" cy="145" r="3" fill="#91b9d5"/>
              <line x1="160" y1="110" x2="95" y2="145" stroke="#91b9d5" stroke-width="0.75" stroke-dasharray="2 3"/>

              <circle cx="215" cy="150" r="3" fill="#d6b881"/>
              <line x1="160" y1="110" x2="215" y2="150" stroke="#d6b881" stroke-width="0.75"/>

              <circle cx="105" cy="70" r="3" fill="#91b9d5"/>
              <line x1="160" y1="110" x2="105" y2="70" stroke="#91b9d5" stroke-width="0.75" stroke-dasharray="2 3"/>
            </g>
          </svg>
        </div>
        <div class="project-body">
          <div class="status">拟开展方向</div>
          <h4 class="card-title">Agent 平台</h4>
          <p class="card-desc">面向办公、编程、科研与教育，让智能从理解问题走向完成任务。</p>
          <div class="project-footer">
            <span>OFFICE · CODE · SCIENCE · LEARNING</span>
            <span class="arrow">&nearr;</span>
          </div>
        </div>
      </article>

      <!-- Card 3: Joint Research -->
      <article class="project-card">
        <div class="project-art">
          <span class="art-label">DISCOVERY / 03</span>
          <span class="art-number">03</span>
          <!-- 3D wireframe Riemannian surface mesh SVG -->
          <svg viewBox="0 0 320 220" fill="none" aria-hidden="true">
            <g opacity="0.85">
              <!-- Undulating mathematical mesh lines -->
              <path d="M60 130 C100 80, 140 160, 180 110 C220 70, 260 140, 280 120" stroke="#91b9d5" stroke-width="0.9" fill="none"/>
              <path d="M55 140 C95 90, 135 170, 175 120 C215 80, 255 150, 275 130" stroke="#91b9d5" stroke-width="0.8" stroke-dasharray="3 3" fill="none" opacity="0.6"/>
              <path d="M65 120 C105 70, 145 150, 185 100 C225 60, 265 130, 285 110" stroke="#d6b881" stroke-width="1.1" fill="none"/>
              <path d="M70 110 C110 60, 150 140, 190 90 C230 50, 270 120, 290 100" stroke="#d6b881" stroke-width="0.8" stroke-dasharray="2 4" fill="none" opacity="0.5"/>

              <!-- Cross grid lines -->
              <line x1="105" y1="70" x2="95" y2="140" stroke="#91b9d5" stroke-width="0.6" opacity="0.5"/>
              <line x1="145" y1="150" x2="135" y2="170" stroke="#91b9d5" stroke-width="0.6" opacity="0.5"/>
              <line x1="185" y1="100" x2="175" y2="120" stroke="#d6b881" stroke-width="0.8" opacity="0.6"/>
              <line x1="225" y1="60" x2="215" y2="80" stroke="#91b9d5" stroke-width="0.6" opacity="0.5"/>

              <!-- Critical optimum point -->
              <circle cx="185" cy="100" r="3" fill="#d6b881"/>
            </g>
          </svg>
        </div>
        <div class="project-body">
          <div class="status">拟开展方向</div>
          <h4 class="card-title">联合研究</h4>
          <p class="card-desc">与高校和研究团队一起，从重要问题出发，连接理论探索与系统实践。</p>
          <div class="project-footer">
            <span>UNIVERSITIES · LABS · INDUSTRY</span>
            <span class="arrow">&nearr;</span>
          </div>
        </div>
      </article>
    </div>

    <!-- Footnote -->
    <div class="project-footnote">
      <span>以上为拟开展的业务方向；具体项目名称与发布状态将在确认后更新。</span>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: 100px;
    position: relative;
    z-index: 5;
  }

  .manifesto {
    display: grid;
    grid-template-columns: 1fr 2.4fr;
    gap: 60px;
    padding-bottom: 70px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 70px;
  }

  .statement {
    font-size: clamp(22px, 2.5vw, 32px);
    line-height: 1.7;
    letter-spacing: 0.04em;
    font-weight: 400;
  }

  .statement-note {
    font-size: 13px;
    color: var(--muted);
    margin-top: 18px;
    line-height: 2;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 40px;
  }

  .section-title {
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.4;
    letter-spacing: 0.03em;
    margin-top: 12px;
  }

  .sub {
    color: var(--muted);
    font-size: 13px;
    margin-top: 10px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .project-card {
    border: 1px solid var(--line);
    background: linear-gradient(155deg, rgba(18, 24, 36, 0.75), rgba(11, 14, 20, 0.92));
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: rgba(214, 184, 129, 0.35);
  }

  .project-art {
    height: 210px;
    position: relative;
    background: radial-gradient(ellipse at 50% 70%, rgba(82, 115, 153, 0.12), transparent 70%);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .project-art svg {
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-art svg {
    transform: scale(1.05);
  }

  .art-label {
    position: absolute;
    left: 20px;
    top: 18px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .art-number {
    position: absolute;
    right: 20px;
    top: 16px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--gold);
  }

  .project-body {
    padding: 26px 24px 22px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .status {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--faint);
    letter-spacing: 0.05em;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .status::before {
    content: "";
    width: 4px;
    height: 4px;
    border: 1px solid var(--gold);
    border-radius: 50%;
  }

  .card-title {
    font-size: 22px;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }

  .card-desc {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.9;
    flex-grow: 1;
  }

  .project-footer {
    border-top: 1px solid var(--line);
    margin-top: 24px;
    padding-top: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--faint);
  }

  .project-footer .arrow {
    color: var(--gold);
    font-size: 15px;
  }

  .project-footnote {
    margin-top: 20px;
    font-size: 11px;
    color: var(--faint);
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .project-footnote::before {
    content: "";
    width: 4px;
    height: 4px;
    background: var(--faint);
    border-radius: 50%;
  }

  @media (max-width: 900px) {
    .manifesto {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-bottom: 40px;
      margin-bottom: 40px;
    }
    .project-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
