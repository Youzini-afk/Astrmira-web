---
import type { Paper } from '../data/papers';
interface Props { kind: Paper['artwork'] }
const { kind } = Astro.props;
const nodes = [[64, 144], [131, 81], [151, 174], [211, 112], [277, 69], [298, 163]];
const edges = [[0, 1], [0, 2], [1, 2], [1, 3], [2, 3], [2, 5], [3, 4], [3, 5], [4, 5]];
---

<svg viewBox="0 0 380 220" fill="none" aria-hidden="true">
  <g stroke="var(--blue)" opacity=".08" stroke-width=".7">
    <path d="M38 192H342M190 34V205" />
    <ellipse cx="190" cy="121" rx="142" ry="70" stroke-dasharray="2 7" />
  </g>
  {kind === 'decisions' && <>
    <path d="M192 45V191" stroke="var(--gold)" stroke-dasharray="3 5" opacity=".5" />
    <path d="M55 172C101 172 113 71 148 71S189 172 244 172M134 172C195 172 202 97 240 97S284 172 329 172" stroke="var(--blue)" opacity=".5" />
    <path d="M145 170H238M145 164V176M238 164V176" stroke="var(--gold)" opacity=".65" />
    <circle cx="148" cy="71" r="4" fill="var(--gold)" />
    <circle cx="240" cy="97" r="4" stroke="var(--gold)" />
    <path d="M148 84V147M240 110V147" stroke="var(--blue)" opacity=".25" stroke-dasharray="2 5" />
    <text x="192" y="198" text-anchor="middle">MARGIN</text>
    <text x="148" y="55" text-anchor="middle">a</text><text x="240" y="81" text-anchor="middle">b</text>
  </>}
  {kind === 'moves' && <>
    <g stroke="var(--blue)" opacity=".22">
      {Array.from({ length: 4 }, (_, i) => <>
        <path d={`M${76 + i * 46} ${104 + i * 21}l92 -60`} />
        <path d={`M${76 + i * 31} ${104 - i * 20}l138 63`} />
      </>)}
    </g>
    <path d="M76 104L122 125L153 105L199 126L230 106L276 127" stroke="var(--gold)" opacity=".85" />
    <path d="M76 104Q153 13 276 127" stroke="var(--blue)" opacity=".5" stroke-dasharray="3 5" />
    {[[76, 104], [122, 125], [153, 105], [199, 126], [230, 106], [276, 127]].map(([x, y], i) => <circle cx={x} cy={y} r={i === 0 || i === 5 ? 4 : 2.5} fill="var(--gold)" />)}
    <circle cx="199" cy="126" r="12" stroke="var(--gold)" opacity=".25" />
    <text x="76" y="89" text-anchor="middle">q</text><text x="290" y="143">q′</text>
    <text x="190" y="198" text-anchor="middle">STATE · PATH · UTILITY</text>
  </>}
  {kind === 'covariance' && <>
    <g transform="translate(134 118) rotate(-28)">
      {[1, .73, .46].map(scale => <ellipse rx={91 * scale} ry={39 * scale} stroke="var(--blue)" opacity={.4 * scale} />)}
      <path d="M-105 0H105M0 -55V55" stroke="var(--gold)" opacity=".35" />
      {Array.from({ length: 25 }, (_, i) => <circle cx={Math.sin(i * 2.4) * (25 + i * 2)} cy={Math.cos(i * 1.8) * (6 + i * .6)} r={i % 7 === 0 ? 2.5 : 1.5} fill={i % 7 === 0 ? 'var(--gold)' : 'var(--blue)'} opacity=".65" />)}
    </g>
    <path d="M251 76h-7v84h7M328 76h7v84h-7" stroke="var(--blue)" opacity=".35" />
    {Array.from({ length: 16 }, (_, i) => <rect x={256 + (i % 4) * 18} y={84 + Math.floor(i / 4) * 18} width="12" height="12" fill={i % 5 === 0 ? 'var(--gold)' : 'var(--blue)'} opacity={i % 5 === 0 ? .65 : .12 + Math.sin(i) ** 2 * .18} />)}
    <text x="190" y="198" text-anchor="middle">COVARIANCE · GEOMETRY</text>
  </>}
  {kind === 'quiver' && <>
    <g stroke="var(--blue)" opacity=".35">
      {edges.map(([a, b]) => <path d={`M${nodes[a][0]} ${nodes[a][1]}L${nodes[b][0]} ${nodes[b][1]}`} />)}
    </g>
    <path d="M64 144L131 81L211 112L277 69" stroke="var(--gold)" opacity=".85" />
    {nodes.map(([x, y], i) => <g>
      <circle cx={x} cy={y} r="8" fill="var(--panel)" stroke={i === 2 || i === 5 ? 'var(--blue)' : 'var(--gold)'} opacity=".8" />
      <circle cx={x} cy={y} r="2.5" fill={i === 2 || i === 5 ? 'var(--blue)' : 'var(--gold)'} />
    </g>)}
    <g stroke="var(--gold)" opacity=".45"><circle cx="277" cy="69" r="17" /><path d="M277 45V39M300 69h6" /></g>
    <text x="190" y="208" text-anchor="middle">BINARY GRAPH → RERANK</text>
  </>}
</svg>

<style>
  svg { display: block; width: 100%; height: 100%; }
  text { fill: var(--faint); font: 9px var(--mono); letter-spacing: 1.5px; }
</style>
