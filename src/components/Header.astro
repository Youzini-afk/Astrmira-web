---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="brand" aria-label="Astrmira 首页">
      <svg class="brand-symbol" viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <ellipse cx="24" cy="24" rx="21" ry="9" transform="rotate(-36 24 24)" stroke="currentColor" stroke-width="1.2"/>
        <path d="M24 8C25.3 20.3 27.7 22.7 40 24C27.7 25.3 25.3 27.7 24 40C22.7 27.7 20.3 25.3 8 24C20.3 22.7 22.7 20.3 24 8Z" fill="currentColor"/>
        <circle cx="40" cy="12" r="1.8" fill="currentColor"/>
      </svg>
      <div class="brand-text">
        <span class="brand-name">Astrmira</span>
        <span class="brand-cn">幻梦星芒 · 研究天文台</span>
      </div>
    </a>

    <nav class="site-nav" id="main-nav" aria-label="主导航">
      <a href="/projects" class={currentPath === '/projects' ? 'is-active' : ''}>Projects</a>
      <a href="/research" class={currentPath === '/research' ? 'is-active' : ''}>Research</a>
      <a href="/about" class={currentPath === '/about' ? 'is-active' : ''}>About</a>
      <a href="/contact" class="nav-contact">
        开始合作 <span class="arrow">&nearr;</span>
      </a>
    </nav>

    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="切换菜单">
      <span>菜单</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    height: 90px;
    position: relative;
    z-index: 50;
    border-bottom: 1px solid rgba(179, 195, 219, 0.08);
    background: rgba(9, 12, 18, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .site-header-inner {
    height: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--pad);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .brand-symbol {
    width: 34px;
    height: 34px;
    color: var(--gold);
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--serif);
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text);
  }

  .brand-cn {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    color: var(--muted);
    margin-top: 4px;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .site-nav a {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: #b0b9c6;
    transition: color 0.25s;
    position: relative;
  }

  .site-nav a:hover,
  .site-nav a.is-active {
    color: var(--gold);
  }

  .site-nav .nav-contact {
    border-left: 1px solid var(--line);
    padding-left: 32px;
    margin-left: 8px;
    color: var(--text);
    display: inline-flex;
    align-items: center;
  }

  .site-nav .nav-contact:hover {
    color: var(--gold);
  }

  .site-nav .nav-contact .arrow {
    margin-left: 8px;
    color: var(--gold);
    transition: transform 0.25s;
  }

  .site-nav .nav-contact:hover .arrow {
    transform: translate(2px, -2px);
  }

  .menu-toggle {
    display: none;
    border: 1px solid var(--line);
    padding: 8px 14px;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--mono);
  }

  @media (max-width: 768px) {
    .site-header {
      height: 76px;
    }
    .brand-name {
      font-size: 22px;
    }
    .brand-cn {
      font-size: 8px;
    }
    .menu-toggle {
      display: block;
    }
    .site-nav {
      display: none;
      position: absolute;
      top: 76px;
      left: 0;
      right: 0;
      background: rgba(16, 20, 28, 0.98);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--line);
      padding: 24px var(--pad);
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .site-nav.is-open {
      display: flex;
    }
    .site-nav .nav-contact {
      border-left: none;
      border-top: 1px solid var(--line);
      padding-left: 0;
      margin-left: 0;
      padding-top: 20px;
      width: 100%;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
