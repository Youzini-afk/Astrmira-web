---
import { LOCALES, localePath, type Locale } from '../i18n';
import { getUi } from '../i18n/content';
import StarLink from './StarLink.astro';
interface Props {
  currentRoute?: string;
  locale?: Locale;
  currentPath?: string;
}
const { currentRoute = 'home', locale = 'zh-cn', currentPath = '/' } = Astro.props;
const ui = getUi(locale);
const href = (path: string) => localePath(path, locale);
const languages = LOCALES.map(item => ({ locale: item.id, lang: item.lang, label: item.name, recommendation: item.recommendation }));
const languageLabel = ui.nav.currentLanguage.replace('{language}', LOCALES.find(item => item.id === locale)!.name);
const navigation = [
  { route: 'home', path: '/', label: ui.nav.home },
  { route: 'projects', path: '/projects/', label: ui.nav.projects },
  { route: 'research', path: '/research/', label: ui.nav.research },
  { route: 'about', path: '/about/', label: ui.nav.about },
];
const isCurrent = (route: string) => currentRoute === route || (route !== 'home' && currentRoute.startsWith(route + '/'));
---

<header class="site-header">
  <a href={href('/')} data-route="home" class="brand" aria-label={ui.nav.homeLabel}>
    <svg class="brand-symbol" viewBox="0 0 48 48" fill="none" aria-hidden="true">
      <ellipse cx="24" cy="24" rx="21" ry="9" transform="rotate(-36 24 24)" stroke="currentColor" stroke-width=".8"/>
      <path d="M24 8C25.3 20.3 27.7 22.7 40 24C27.7 25.3 25.3 27.7 24 40C22.7 27.7 20.3 25.3 8 24C20.3 22.7 22.7 20.3 24 8Z" fill="currentColor"/>
      <circle cx="40" cy="12" r="1.7" fill="currentColor"/>
    </svg>
    <span class="brand-name">Astrmira<span class="brand-cn">{locale === 'zh-hant' ? '幻夢星芒' : '幻梦星芒'}</span></span>
  </a>
  <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>{ui.nav.menu} <span aria-hidden="true">＋</span></button>
  <nav id="site-nav" class="site-nav" aria-label={ui.nav.navigation}>
    <div class="nav-group" data-nav-group>
      {navigation.map(item => <a href={href(item.path)} data-route={item.route} data-nav-link aria-current={isCurrent(item.route) ? 'page' : undefined}>{item.label}</a>)}
      <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
    </div>
    <details class="language-picker" data-language-picker>
      <summary class="language-trigger" aria-label={languageLabel} title={ui.nav.language} aria-controls="language-options">
        <svg class="language-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <ellipse cx="12" cy="12" rx="4" ry="9" />
          <path d="M3 12h18M4.3 7.5h15.4M4.3 16.5h15.4" />
        </svg>
        <svg class="language-chevron" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="m2 3.5 3 3 3-3" /></svg>
      </summary>
      <ul class="language-options" id="language-options">
        {languages.map(language => <li>
          <a href={localePath(currentPath, language.locale)} data-locale-choice={language.locale} lang={language.lang} hreflang={language.lang} aria-current={locale === language.locale ? 'true' : undefined}>
            <span>{language.label}</span>
            <span class="language-recommendation" data-locale-recommendation hidden>{language.recommendation}</span>
            {locale === language.locale && <svg class="language-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m3 8 3 3 7-7" /></svg>}
          </a>
        </li>)}
      </ul>
    </details>
    <details class="work-menu" data-work-menu>
      <StarLink as="summary" class="nav-contact" label={ui.nav.collaborate} compact aria-controls="work-options" />
      <ul class="work-options" id="work-options">
        <li><a href={href('/collaborate/')} data-route="collaborate" aria-current={currentRoute === 'collaborate' ? 'page' : undefined}>{ui.nav.contact}<span aria-hidden="true">↗</span></a></li>
        <li><a href={href('/careers/')} data-route="careers" aria-current={currentRoute === 'careers' ? 'page' : undefined}>{ui.nav.careers}<span aria-hidden="true">↗</span></a></li>
      </ul>
    </details>
  </nav>
</header>

<style>
  /* Sliding highlight inspired by gleydson_9898's Uiverse.io liquid group.
     Real links retain native navigation; unequal widths accommodate every locale. */
  .nav-group { position: relative; display: inline-flex; align-items: stretch; gap: 2px; padding: 5px; border: 1px solid #b3c9df18; border-radius: 15px; background: #0a0d12b3; isolation: isolate; }
  .nav-group a { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; min-height: 40px; padding: 8px 16px; border-radius: 10px; color: #a7b0bc; font: 500 13px/1.6 var(--sans); letter-spacing: .02em; white-space: nowrap; transition: color .25s ease, transform .15s ease; }
  .nav-group a[aria-current="page"] { color: #eee7d9; }
  .nav-group:not(.has-nav-indicator) a[aria-current="page"] { background: #242a32; box-shadow: inset 0 1px #e9eff50d, inset 0 -1px 2px #0005; }
  .nav-group.has-nav-indicator a[aria-current="page"] { color: #a7b0bc; }
  .nav-group.has-nav-indicator a.is-highlighted { color: #eee7d9; }
  .nav-group a:active { transform: scale(.97); }
  .nav-group a:focus-visible { outline: 2px solid var(--gold); outline-offset: -3px; }
  .nav-indicator { position: absolute; z-index: 0; left: 0; top: 0; width: var(--nav-width, 0px); height: var(--nav-height, 0px); transform: translate(var(--nav-x, 0px), var(--nav-y, 0px)); border-radius: 10px; pointer-events: none; background: #242a32; box-shadow: inset 0 1px #e9eff50d, inset 0 -1px 2px #0005; opacity: 0; transition: transform .45s cubic-bezier(.22,.9,.25,1), width .45s cubic-bezier(.22,.9,.25,1), height .45s cubic-bezier(.22,.9,.25,1), opacity .2s; }
  .has-nav-indicator.has-nav-target .nav-indicator { opacity: 1; }
  .nav-positioning .nav-indicator, :global(html.is-paused) .nav-indicator { transition: none; }
  @media (hover: hover) and (pointer: fine) { .nav-group a:hover { color: #eee7d9; } }
  @media (max-width: 1100px) { .nav-group a { padding-inline: 12px; } }
  @media (pointer: coarse) { .nav-group a { min-height: 44px; } }
  .language-picker { position: relative; flex-shrink: 0; }
  .language-trigger { display: flex; align-items: center; justify-content: center; gap: 6px; min-width: 48px; min-height: 44px; padding: 8px; list-style: none; color: #bcc3cd; border: 1px solid transparent; border-radius: var(--radius-control); cursor: pointer; transition: color .2s, border-color .2s, background-color .2s; }
  .language-trigger::-webkit-details-marker { display: none; }
  .language-trigger:hover, .language-picker[open] .language-trigger { color: var(--gold); border-color: var(--line); background: #d6b88105; }
  .language-trigger:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
  .language-globe { width: 20px; height: 20px; }
  .language-chevron { width: 10px; height: 10px; transition: transform .2s; }
  .language-picker[open] .language-chevron { transform: rotate(180deg); }
  .language-options { position: absolute; top: calc(100% + 10px); right: 0; z-index: 1; width: 244px; margin: 0; padding: 7px; list-style: none; border: 1px solid var(--line); border-radius: 12px; background: #10141c; box-shadow: 0 12px 32px #0006; }
  .language-picker[open] .language-options { animation: language-appear .16s ease-out; }
  .language-options { max-height: min(360px, calc(100dvh - 110px)); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .language-options a { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 44px; padding: 10px 12px; border-radius: 7px; color: var(--muted); font: 13px/1.6 var(--sans); transition: color .2s, background-color .2s; }
  .language-options a:hover, .language-options a:focus-visible { color: var(--text); background: #91b9d50a; }
  .language-options a[aria-current="true"] { color: var(--gold); background: #d6b8810a; }
  .language-options a:focus-visible { outline-offset: -2px; }
  .language-check { width: 16px; height: 16px; flex-shrink: 0; }
  .language-recommendation { font-size: 10px; color: var(--gold); }
  @keyframes language-appear { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
  .work-menu { position: relative; flex-shrink: 0; }
  .work-options { position: absolute; top: 100%; right: 0; z-index: 2; width: max-content; min-width: 210px; max-width: min(300px, calc(100vw - 40px)); margin: 0; padding: 9px 7px 7px; list-style: none; border: 1px solid var(--line); border-radius: 11px; background: #10141c; box-shadow: 0 12px 32px #0006; }
  .work-menu[open] .work-options { animation: language-appear .16s ease-out; }
  .work-options li + li { margin-top: 3px; border-top: 1px solid #b3c9df12; padding-top: 3px; }
  .work-options a { display: flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 46px; padding: 12px; border-radius: 6px; color: var(--muted); font: 13px/1.6 var(--sans); }
  .work-options a span { color: var(--gold); }
  .work-options a:is(:hover, :focus-visible), .work-options a[aria-current="page"] { color: var(--text); background: #d6b8810a; }
  .work-options a:focus-visible { outline-offset: -2px; }
  @media (max-width: 900px) {
    .nav-group { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; width: 100%; }
    .nav-group a { min-width: 0; min-height: 46px; padding: 10px 12px; font-size: 14px; }
    .language-picker { align-self: stretch; margin: 8px 0; }
    .language-trigger { width: fit-content; }
    .language-options { position: static; width: min(100%, 240px); margin-top: 8px; box-shadow: none; max-height: none; overflow: visible; }
    .language-options a { font-size: 14px; }
    .work-options { position: static; width: 100%; min-width: 0; max-width: none; margin-top: 8px; box-shadow: none; }
    .work-options a { font-size: 14px; }
  }
</style>
