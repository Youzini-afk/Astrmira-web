---
import PaperArtwork from './PaperArtwork.astro';
import { paperUrl, arxivUrl, type Paper } from '../data/papers';
import { getContent, getUi } from '../i18n/content';
import { localePath, type Locale } from '../i18n';
interface Props { paper: Paper; headingLevel?: 'h2' | 'h3'; locale?: Locale }
const { paper, headingLevel: Heading = 'h3', locale = 'zh-cn' } = Astro.props;
const localized = locale === 'zh-cn' ? paper : getContent(locale).papers[paper.slug];
const ui = getUi(locale);
const previewId = `paper-preview-${paper.slug}`;
---

<article class="paper-card" data-paper-book data-research-item data-theme={paper.themes.join(' ')} data-search={[paper.title, localized.heading, localized.summary, ...paper.authors, ...localized.tags, paper.arxiv].join(' ')}>
  <div class="paper-book">
    <div class="paper-cover" data-paper-cover>
      <div class="paper-art-meta"><span>{paper.category}</span><time datetime={paper.submitted}>{paper.submitted.slice(0, 7).replace('-', '.')}</time></div>
      <Heading>{localized.heading}</Heading>
      <p class="paper-cover-authors">{paper.authors.join(' · ')}</p>
      <div class="paper-art"><PaperArtwork kind={paper.artwork} /></div>
      <span class="paper-cover-imprint" aria-hidden="true">ASTRMIRA <span>RESEARCH</span></span>
    </div>
    <div class="paper-inside" id={previewId} data-paper-preview>
      <p class="paper-preview-label">{ui.paper.preview}</p>
      <p class="paper-original-title" lang="en">{paper.title}</p>
      <p class="paper-summary">{localized.summary}</p>
      <p class="paper-tags">{localized.tags.slice(0, 2).join(' · ')}</p>
      <a class="paper-card-main text-link" href={localePath(paperUrl(paper), locale)} data-route={`research/papers/${paper.slug}`}>
        {ui.paper.readOverview}<span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <div class="paper-card-footer">
    <button type="button" class="paper-toggle" data-paper-toggle data-open-label={ui.paper.openPreview} data-close-label={ui.paper.closePreview} aria-label={`${ui.paper.openPreview} · ${localized.heading}`} aria-controls={previewId} aria-expanded="false" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M12 5.5C9 3.5 5.5 3.5 3 4.5v14c3-1 6-.5 9 1.5 3-2 6-2.5 9-1.5v-14c-2.5-1-6-1-9 1Z"/><path d="M12 5.5V20"/></svg>
      <span data-paper-toggle-label>{ui.paper.openPreview}</span>
    </button>
    <a href={arxivUrl(paper)} target="_blank" rel="noopener noreferrer" aria-label={ui.research.arxivLabel.replace('{title}', paper.title)}>arXiv <span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .paper-card { min-width: 0; width: 100%; max-width: 320px; display: flex; flex-direction: column; }
  .paper-book { position: relative; flex: 1; border-radius: 2px 4px 4px 2px; background: #13171c; box-shadow: 0 1px 2px #00000038, 0 9px 16px -9px #00000060; }
  .paper-cover, .paper-inside { min-width: 0; padding: 24px 22px 22px 26px; border-radius: inherit; overflow-wrap: anywhere; }
  .paper-cover { --blue: #adb8c1; --gold: #c0ad88; --faint: #7e8994; --panel: #13171c; position: relative; display: flex; flex-direction: column; background: #13171c; border: 1px solid #c1cbd512; }
  .paper-cover::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 10px; border-right: 1px solid #ccd4dc05; background: linear-gradient(90deg, #05080c50, transparent); pointer-events: none; }
  .paper-art-meta { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; color: #8e9aa5; font: 9px/1.8 var(--mono); letter-spacing: .04em; }
  .paper-art-meta time { white-space: nowrap; color: #9aa4ac; font-variant-numeric: tabular-nums; }
  .paper-cover :is(h2, h3) { color: #e5e3dc; font: 400 23px/1.45 var(--serif); letter-spacing: -.015em; text-wrap: balance; margin: 24px 0 10px; }
  .paper-cover-authors { margin: 0; color: #9aa4ab; font: 11px/1.8 var(--sans); text-wrap: pretty; }
  .paper-art { display: grid; align-items: center; flex: 1; min-height: 130px; margin: 14px -10px 10px; }
  .paper-art > :global(svg) { height: auto; width: 100%; }
  .paper-cover-imprint { display: flex; justify-content: space-between; gap: 12px; padding-top: 12px; border-top: 1px solid #c1cbd516; color: #adb1b2; font: 9px/1.7 var(--mono); letter-spacing: .12em; }
  .paper-cover-imprint span { color: #7e8990; letter-spacing: .07em; }
  .paper-inside { --gold: #c6b089; --text: #e5e3dc; --muted: #b7bfc6; --faint: #939ea8; position: relative; display: flex; flex-direction: column; color: var(--muted); background: #1b2026; box-shadow: inset 16px 0 18px -14px #020407aa, inset -1px 0 #aab7c024; }
  .paper-preview-label { margin: 0 0 16px; color: var(--gold); font: 10px/1.8 var(--mono); letter-spacing: .08em; }
  .paper-original-title { color: var(--text); font: 400 17px/1.45 var(--serif); margin: 0 0 16px; text-wrap: pretty; }
  .paper-summary { color: var(--muted); font: 14px/1.8 var(--sans); margin: 0 0 18px; text-wrap: pretty; }
  .paper-tags { margin: auto 0 8px; padding-top: 10px; color: var(--faint); font: 11px/1.8 var(--sans); }
  .paper-card-main { align-self: flex-start; min-height: 44px; margin: 0; color: var(--gold); }
  .paper-card-footer { display: flex; justify-content: space-between; align-items: center; gap: 18px; padding: 10px 3px 0; }
  .paper-toggle, .paper-card-footer > a { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 4px 0; color: var(--muted); font: 11px/1.8 var(--sans); transition: color .2s; }
  .paper-toggle { border: 0; background: none; cursor: pointer; text-align: left; }
  .paper-toggle[hidden] { display: none; }
  .paper-toggle svg { flex-shrink: 0; color: var(--gold); }
  .paper-card-footer > a { margin-left: auto; white-space: nowrap; font-family: var(--mono); }
  .paper-card-footer > a span { color: var(--gold); font-size: 17px; }
  .paper-toggle:focus-visible, .paper-card-main:focus-visible, .paper-card-footer > a:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; border-radius: 3px; }
  /* The left-hinged cover follows the Uiverse.io book interaction by eslam-hany.
     Both faces size the grid: translations and enlarged text never get cropped. */
  .is-book { --book-lift: 0px; --book-scale: 1; --book-elevation: 0; --book-sheen: 0; --book-duration: .38s; --book-delay: .16s; }
  .is-book .paper-book { display: grid; aspect-ratio: 3 / 4; perspective: 3200px; perspective-origin: left center; isolation: isolate; transform: translateY(var(--book-lift)) scale(var(--book-scale)); transition: transform var(--book-duration) var(--ease-ui) var(--book-delay); }
  /* Lift and press inspired by SteveBloX's Uiverse.io card. Fade a prepainted
     shadow instead of animating a large blur over the moving star background. */
  .is-book .paper-book::before { content: ''; position: absolute; z-index: -1; inset: 0; border-radius: inherit; pointer-events: none; box-shadow: 0 5px 8px #00000030, 0 18px 28px -14px #00000075; opacity: var(--book-elevation); transition: opacity var(--book-duration) var(--ease-ui) var(--book-delay); }
  .is-book .paper-book::after { content: ''; position: absolute; z-index: -1; inset: 7px -1px 7px auto; width: 2px; border-radius: 0 2px 2px 0; background: #62676a; }
  .is-book .paper-cover, .is-book .paper-inside { grid-area: 1 / 1; }
  .is-book .paper-cover::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: #f4eee003; opacity: var(--book-sheen); transition: opacity var(--book-duration) var(--ease-ui) var(--book-delay); }
  .is-book .paper-cover { z-index: 2; transform-origin: left center; backface-visibility: hidden; cursor: pointer; box-shadow: 2px 2px 5px #00000040; transition: transform .65s cubic-bezier(.2,.65,.25,1), box-shadow .65s; }
  .is-book .paper-inside { padding-left: max(48px, 16%); visibility: hidden; transition: visibility 0s .65s; }
  .is-book.is-open { --book-lift: -4px; --book-scale: 1.015; --book-elevation: 1; --book-sheen: 1; --book-duration: .28s; --book-delay: 0s; }
  .is-book.is-open .paper-cover { transform: rotateY(-84deg); box-shadow: 10px 4px 20px #00000050; pointer-events: none; transition-delay: .08s; }
  .is-book.is-open .paper-inside { visibility: visible; transition-delay: 0s; }
  .is-book:has(.paper-book:active, .paper-toggle:active) { --book-lift: 0px; --book-scale: .99; --book-elevation: .12; --book-sheen: .35; --book-duration: .1s; --book-delay: 0s; }
  .is-open .paper-toggle { color: var(--gold); }
  :global(html:lang(de)) .paper-book { hyphens: auto; }
  @media (hover: hover) and (pointer: fine) { .paper-toggle:hover, .paper-card-footer > a:hover { color: var(--gold); } }
  @media (max-width: 720px) {
    .paper-cover, .paper-inside { padding: 22px 20px 20px 26px; }
    .paper-card-footer { gap: 12px; }
  }
  :global(html.is-paused) .is-book .paper-cover, :global(html.is-paused) .is-book .paper-inside { transition: none; }
  :global(html.is-paused) .is-book.is-open .paper-cover { transform: none; opacity: 0; }
  :global(html.is-paused) .is-book .paper-book { --book-lift: 0px; --book-scale: 1; --book-duration: 0s; --book-delay: 0s; }
</style>
