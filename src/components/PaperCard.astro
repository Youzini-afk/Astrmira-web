---
import PaperArtwork from './PaperArtwork.astro';
import { paperUrl, arxivUrl, type Paper } from '../data/papers';
interface Props { paper: Paper; headingLevel?: 'h2' | 'h3' }
const { paper, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="paper-card" data-research-item data-theme={paper.themes.join(' ')} data-search={[paper.title, paper.heading, paper.summary, ...paper.authors, ...paper.tags, paper.arxiv].join(' ')}>
  <a class="paper-card-main" href={paperUrl(paper)} data-route={`research/papers/${paper.slug}`}>
    <div class="paper-art">
      <div class="paper-art-meta"><span>{paper.category}</span><time datetime={paper.submitted}>{paper.submitted.slice(0, 7).replace('-', '.')}</time></div>
      <PaperArtwork kind={paper.artwork} />
    </div>
    <div class="paper-copy">
      <Heading>{paper.heading}</Heading>
      <p class="paper-original-title" lang="en">{paper.title}</p>
      <p class="paper-summary">{paper.summary}</p>
    </div>
  </a>
  <div class="paper-card-footer">
    <span>{paper.tags.slice(0, 2).join(' · ')}</span>
    <a href={arxivUrl(paper)} target="_blank" rel="noopener noreferrer" aria-label={`在 arXiv 阅读 ${paper.title}（新窗口）`}>arXiv <span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .paper-card { min-width: 0; display: flex; flex-direction: column; border: 1px solid var(--line); background: linear-gradient(145deg, #121923a6, #0a0e15c9); transition: border-color .25s, background-color .25s; }
  .paper-card:hover, .paper-card:focus-within { border-color: #b1c8e052; background-color: #91b9d507; }
  .paper-card-main { display: flex; flex: 1; flex-direction: column; }
  .paper-art { height: 222px; padding: 24px 8px 2px; position: relative; border-bottom: 1px solid var(--line); }
  .paper-art-meta { position: absolute; top: 17px; left: 22px; right: 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--faint); font: 9px var(--mono); letter-spacing: .06em; }
  .paper-art-meta time { white-space: nowrap; color: var(--gold); }
  .paper-copy { padding: 26px 25px 22px; }
  .paper-copy :is(h2, h3) { color: var(--text); font: 400 22px/1.55 var(--sans); letter-spacing: .01em; text-wrap: pretty; margin: 0 0 14px; }
  .paper-original-title { color: #c1c8d2; font: 14px/1.6 var(--serif); margin: 0 0 18px; }
  .paper-summary { font: 12px/1.95 var(--sans); color: var(--muted); margin: 0; }
  .paper-card-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: auto 25px 0; padding: 17px 0 22px; border-top: 1px solid var(--line); color: var(--faint); font-size: 10px; }
  .paper-card-footer a { color: var(--gold); white-space: nowrap; font: 11px var(--mono); padding: 5px 0 5px 12px; }
  .paper-card-footer a span { margin-left: 6px; font-size: 17px; }
  @media (max-width: 720px) {
    .paper-art { height: 200px; }
    .paper-copy { padding: 23px 22px; }
    .paper-copy :is(h2, h3) { font-size: 20px; }
    .paper-card-footer { margin-inline: 22px; }
  }
</style>
