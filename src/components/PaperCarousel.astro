---
import PaperCard from './PaperCard.astro';
import { papers } from '../data/papers';
import type { Locale } from '../i18n';
import { getUi } from '../i18n/content';
interface Props { locale?: Locale }
const { locale = 'zh-cn' } = Astro.props;
const ui = getUi(locale).carousel;
---

<div class="paper-carousel" data-paper-carousel>
  <div class="paper-carousel-row">
    <div id="home-paper-track" class="paper-track" data-paper-track role="region" aria-label={ui.label} tabindex="0">
      {papers.map(paper => <PaperCard paper={paper} locale={locale} />)}
    </div>
    <div class="paper-carousel-controls" data-paper-controls hidden>
      <button type="button" data-paper-prev aria-label={ui.previous} aria-controls="home-paper-track" disabled><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg></button>
      <button type="button" data-paper-next aria-label={ui.next} aria-controls="home-paper-track"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m10 5 7 7-7 7"/></svg></button>
    </div>
  </div>
  <p class="paper-carousel-note">{ui.note}</p>
  <p class="paper-carousel-status" data-paper-status aria-live="polite" aria-atomic="true"></p>
</div>

<style>
  :global(.section-heading:has(+ [data-paper-carousel])) { margin-bottom: 16px; }
  .paper-carousel-row { position: relative; --arrow-offset: clamp(20px, 3.5vw, 52px); }
  .paper-track { display: grid; grid-auto-flow: column; grid-auto-columns: min(320px, calc((100% - 56px) / 3)); gap: 28px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 44px 8px 16px; scroll-padding-inline: 8px; mask-image: linear-gradient(to right, transparent, #000 var(--fade-left, 0px), #000 calc(100% - var(--fade-right, 0px)), transparent); }
  .paper-track::-webkit-scrollbar { display: none; }
  .paper-track.can-scroll-back { --fade-left: 14px; }
  .paper-track.can-scroll-forward { --fade-right: 14px; }
  .paper-track :global(.paper-card) { scroll-snap-align: start; }
  .paper-track:focus-visible { outline: none; }
  .paper-carousel-row:has(.paper-track:focus-visible) { outline: 1px solid var(--gold); outline-offset: 5px; border-radius: 8px; }
  .paper-carousel-note { margin: 0; color: var(--faint); font-size: 11px; line-height: 1.8; letter-spacing: .03em; }
  /* Keep the hit areas outside the book text, centered on the covers rather than the footer. */
  .paper-carousel-controls { position: absolute; z-index: 3; inset: 44px calc(-1 * var(--arrow-offset)) 70px; display: flex; align-items: center; justify-content: space-between; pointer-events: none; }
  .paper-carousel-controls[hidden] { display: none; }
  .paper-carousel-controls button { display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; border: 1px solid #b3c9df24; border-radius: 50%; background: #0c1017ed; color: var(--gold); cursor: pointer; pointer-events: auto; transition: border-color .2s, background-color .2s, color .2s; }
  .paper-carousel-controls button:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) { .paper-carousel-controls button:hover:enabled { border-color: #d6b88170; background: #1b222c; color: #eee5d2; } }
  .paper-carousel-controls button:disabled { opacity: .28; cursor: default; }
  .paper-carousel-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 1050px) { .paper-track { grid-auto-columns: min(310px, calc((100% - 24px) / 2)); gap: 24px; } }
  @media (max-width: 720px) {
    .paper-track { grid-auto-columns: min(300px, 88%); gap: 24px; }
    .paper-carousel-note { font-size: 10px; max-width: 150px; line-height: 1.8; }
  }
</style>
