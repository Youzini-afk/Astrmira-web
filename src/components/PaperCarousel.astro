---
import PaperCard from './PaperCard.astro';
import { papers } from '../data/papers';
import type { Locale } from '../i18n';
import { getUi } from '../i18n/content';
interface Props { locale?: Locale }
const { locale = 'zh-cn' } = Astro.props;
const ui = getUi(locale).carousel;
---

<div class="paper-carousel" data-paper-carousel>
  <div id="home-paper-track" class="paper-track" data-paper-track role="region" aria-label={ui.label} tabindex="0">
    {papers.map(paper => <PaperCard paper={paper} locale={locale} />)}
  </div>
  <div class="paper-carousel-bottom">
    <span class="paper-carousel-note">{ui.note}</span>
    <div class="paper-carousel-controls" data-paper-controls hidden>
      <span aria-hidden="true">{ui.browse}</span>
      <button type="button" data-paper-prev aria-label={ui.previous} aria-controls="home-paper-track" disabled>←</button>
      <button type="button" data-paper-next aria-label={ui.next} aria-controls="home-paper-track">→</button>
    </div>
  </div>
  <p class="paper-carousel-status" data-paper-status aria-live="polite" aria-atomic="true"></p>
</div>

<style>
  .paper-track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 64px) / 3); gap: 32px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: var(--line) transparent; padding: 9px 8px 16px; scroll-padding-inline: 8px; }
  .paper-track :global(.paper-card) { scroll-snap-align: start; }
  .paper-track:focus-visible { outline: 1px solid var(--gold); outline-offset: 5px; border-radius: 8px; }
  .paper-carousel-bottom { margin-top: 18px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .paper-carousel-note, .paper-carousel-controls > span { color: var(--faint); font-size: 11px; letter-spacing: .03em; }
  .paper-carousel-controls { display: flex; align-items: center; gap: 9px; }
  .paper-carousel-controls > span { margin-right: 9px; }
  .paper-carousel-controls button { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid #b3c9df30; border-radius: 50%; background: #b1c6dc04; color: var(--gold); cursor: pointer; font-size: 19px; transition: border-color .2s, background-color .2s, color .2s; }
  .paper-carousel-controls button:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) { .paper-carousel-controls button:hover:enabled { border-color: var(--gold); background: var(--gold); color: var(--bg); } }
  .paper-carousel-controls button:disabled { opacity: .28; cursor: default; }
  .paper-carousel-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 1050px) { .paper-track { grid-auto-columns: calc((100% - 28px) / 2); gap: 28px; } }
  @media (max-width: 720px) {
    .paper-track { grid-auto-columns: 91%; gap: 24px; }
    .paper-carousel-note { font-size: 10px; max-width: 150px; line-height: 1.8; }
    .paper-carousel-controls > span { display: none; }
  }
</style>
