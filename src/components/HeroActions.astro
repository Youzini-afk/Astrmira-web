---
import { getContent } from '../i18n/content';
import { localePath, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'zh-cn' } = Astro.props;
const labels = locale === 'zh-cn' ? { explore: '探索研究', discover: '发现项目' } : getContent(locale).home;
const actions = [
  { label: labels.explore, href: localePath('/research/', locale), route: 'research', className: 'hero-research' },
  { label: labels.discover, href: '#projects', route: undefined, className: 'hero-discover' },
];

// Bake the stars into four reusable SVG images at build time. Only four small
// image layers move per button; individual particles never animate in the DOM.
const width = 216, height = 64;
const sheets: string[][] = [[], [], [], []];
let seed = 74193;
const random = () => { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return seed / 4294967296; };
let pointIndex = 0;
function addStar(x: number, y: number, rim = false) {
  const distances = [y, width - x, height - y, x];
  const edge = distances.indexOf(Math.min(...distances));
  const quiet = Math.abs(y - height / 2) < 10 && x > 22 && x < width - 22;
  const radius = (rim ? .45 : .38) + random() * .44;
  const opacity = (rim ? .5 + random() * .4 : .28 + random() * .5) * (quiet ? .28 : 1);
  const colour = random() < .22 ? '#c6b28a' : random() < .5 ? '#bdcedc' : '#8fa9bf';
  sheets[edge].push(`<circle cx="${x.toFixed(2)}" cy="${y.toFixed(2)}" r="${radius.toFixed(2)}" fill="${colour}" opacity="${opacity.toFixed(2)}"/>`);
  if (!quiet && pointIndex++ % 31 === 0) {
    const arm = 1.3 + random() * .6;
    sheets[edge].push(`<path d="M${(x - arm).toFixed(2)} ${y.toFixed(2)}h${(arm * 2).toFixed(2)}M${x.toFixed(2)} ${(y - arm).toFixed(2)}v${(arm * 2).toFixed(2)}" fill="none" stroke="${colour}" stroke-width=".45" opacity=".6"/>`);
  }
}
for (let row = 0; row < 8; row++) {
  for (let column = 0; column < 30; column++) {
    addStar(5 + (column + .15 + random() * .7) * (width - 10) / 30,
      5 + (row + .15 + random() * .7) * (height - 10) / 8);
  }
}
for (let i = 0; i < 34; i++) {
  addStar(5 + (i + random() * .7) * (width - 10) / 34, 2 + random() * 1.6, true);
  addStar(5 + (i + random() * .7) * (width - 10) / 34, height - 2 - random() * 1.6, true);
}
for (let i = 0; i < 8; i++) {
  addStar(2 + random(), 5 + (i + random() * .7) * (height - 10) / 8, true);
  addStar(width - 2 - random(), 5 + (i + random() * .7) * (height - 10) / 8, true);
}
const textures = sheets.map((points, i) => `--hero-stars-${i}:url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none">${points.join('')}</svg>`)}")`).join(';');
const offsets = [[0, -5], [5, 0], [0, 5], [-5, 0]];
---

<div class="hero-actions" style={textures}>
  {actions.map(action => <div class="hero-action">
    <a class:list={['hero-particle-link', action.className]} href={action.href} data-route={action.route}>
      <span class="hero-button-field" aria-hidden="true">
        {offsets.map(([x, y], index) => <span class="hero-star-sheet" style={`--star-image:var(--hero-stars-${index});--from-x:${x}px;--from-y:${y}px;`}></span>)}
      </span>
      <span class="hero-link-label">{action.label}</span>
    </a>
  </div>)}
</div>

<style>
  .hero-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 16px; width: min(100%, 384px); margin: 30px auto 0; }
  .hero-action { display: flex; min-width: 0; opacity: 1; transform: none; transition: opacity .55s ease var(--entry-delay, 0s), transform .65s cubic-bezier(.16,1,.3,1) var(--entry-delay, 0s); }
  .hero-action + .hero-action { --entry-delay: .08s; }
  :global(html.motion-ready:not(.is-paused) .hero-particle-mode:not(.is-settled)) .hero-actions:not(:focus-within) { pointer-events: none; }
  :global(html.motion-ready:not(.is-paused) .hero-particle-mode:not(.is-settled)) .hero-actions:not(:focus-within) .hero-action { opacity: 0; transform: translateY(8px); transition: none; }
  .hero-actions:focus-within .hero-action, :global(html.is-paused) .hero-action { transition: none; }

  .hero-particle-link { --field-active: 0; --field-depth: 0%; --field-reveal-time: 0s; --field-reveal-delay: .45s; --field-travel-time: .45s; position: relative; isolation: isolate; display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: 52px; padding: 14px 20px; border: 1px solid #b3c9df30; border-radius: 9px; background: #111820cc; color: #e3e7eb; font: 500 14px/1.55 var(--sans); letter-spacing: .025em; text-decoration: none; transition: color .3s, border-color .3s; }
  .hero-link-label { position: relative; z-index: 1; text-align: center; text-wrap: balance; text-shadow: 0 1px 2px #070b12; }
  .hero-research { --hover-ink: #171c22; --hover-border: #f5eedb; background: #e8e1d2; border-color: #f5eee080; color: #22272d; box-shadow: inset 0 1px #ffffff60; }
  .hero-research .hero-link-label { text-shadow: none; }
  .hero-research .hero-button-field { filter: brightness(.4) saturate(.6); }
  /* The inner aperture closes towards the centre, exposing actual star points
     from all four borders. It never draws a solid fill over the button. */
  .hero-button-field { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; pointer-events: none; opacity: var(--field-active); clip-path: polygon(evenodd, 0 0, 100% 0, 100% 100%, 0 100%, 0 0, var(--field-depth) var(--field-depth), var(--field-depth) calc(100% - var(--field-depth)), calc(100% - var(--field-depth)) calc(100% - var(--field-depth)), calc(100% - var(--field-depth)) var(--field-depth), var(--field-depth) var(--field-depth)); transition: opacity .45s ease, clip-path var(--field-reveal-time) cubic-bezier(.3,.05,.25,1) var(--field-reveal-delay); }
  .hero-star-sheet { position: absolute; inset: 0; background-image: var(--star-image); background-size: 100% 100%; background-repeat: no-repeat; transform: translate(calc(var(--from-x) * (1 - var(--field-active))), calc(var(--from-y) * (1 - var(--field-active)))); transition: transform var(--field-travel-time) cubic-bezier(.3,.05,.25,1); }
  .hero-particle-link:focus-visible { --field-active: 1; --field-depth: 50%; --field-reveal-time: .95s; --field-reveal-delay: .03s; --field-travel-time: .95s; color: var(--hover-ink, #f1eee7); border-color: var(--hover-border, #bdcbd875); outline: 2px solid var(--gold); outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) {
    .hero-particle-link:hover { --field-active: 1; --field-depth: 50%; --field-reveal-time: .95s; --field-reveal-delay: .03s; --field-travel-time: .95s; color: var(--hover-ink, #f1eee7); border-color: var(--hover-border, #bdcbd875); }
  }
  .hero-particle-link:active { --field-active: 1; --field-depth: 50%; --field-reveal-time: 0s; --field-reveal-delay: 0s; --field-travel-time: 0s; border-color: #d3cfb9; }
  .hero-particle-link:active .hero-button-field { transition: none; }
  :global(html.is-paused) .hero-particle-link, :global(html.is-paused) .hero-button-field, :global(html.is-paused) .hero-star-sheet { transition: none; }
  @media (max-width: 720px) {
    .hero-actions { gap: 12px; margin-top: 26px; }
    .hero-particle-link { min-height: 48px; padding: 12px 14px; font-size: 13px; }
  }
  @media (max-height: 500px) and (min-width: 600px) and (max-width: 1100px) {
    .hero-actions { gap: 14px; margin-top: 20px; }
    .hero-particle-link { min-height: 44px; padding: 10px 14px; font-size: 12px; }
  }
</style>
