---
import StarLink from './StarLink.astro';
import { getContent } from '../i18n/content';
import { localePath, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'zh-cn' } = Astro.props;
const labels = locale === 'zh-cn' ? { explore: '探索研究', discover: '发现项目' } : getContent(locale).home;
---

<div class="hero-actions">
  <div class="hero-action">
    <StarLink href={localePath('/research/', locale)} data-route="research" class="hero-research" label={labels.explore} variant="primary" arrow="→" />
  </div>
  <div class="hero-action">
    <a class="hero-discover" href="#projects">
      <span>{labels.discover}</span>
      <span class="discover-orbit" aria-hidden="true">
        <span class="discover-track">{[0, 1].map(() => <span class="discover-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 5v14m-7-7 7 7 7-7"/></svg></span>)}</span>
      </span>
    </a>
  </div>
</div>

<style>
  .hero-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px 22px; margin-top: 30px; }
  .hero-action { min-width: 0; max-width: 100%; opacity: 1; transform: none; transition: opacity .55s ease var(--entry-delay, 0s), transform .65s cubic-bezier(.16,1,.3,1) var(--entry-delay, 0s); }
  .hero-action + .hero-action { --entry-delay: .08s; }
  /* Share the title's existing completion signal; no extra clock or render loop.
     Keyboard focus can reveal these links immediately, before the intro finishes. */
  :global(html.motion-ready:not(.is-paused) .hero-particle-mode:not(.is-settled)) .hero-actions:not(:focus-within) { pointer-events: none; }
  :global(html.motion-ready:not(.is-paused) .hero-particle-mode:not(.is-settled)) .hero-actions:not(:focus-within) .hero-action { opacity: 0; transform: translateY(8px); transition: none; }
  .hero-actions:focus-within .hero-action, :global(html.is-paused) .hero-action { transition: none; }
  .hero-discover { --discover-active: 0; display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 52px; padding: 4px 0; border-radius: 9px; color: #c3ccd6; font: 500 14px/1.6 var(--sans); letter-spacing: .02em; text-decoration: none; white-space: nowrap; transition: color .2s, transform .12s; }
  .discover-orbit { position: relative; flex-shrink: 0; width: 40px; height: 40px; overflow: hidden; border-radius: 50%; color: var(--gold); }
  .discover-orbit::before, .discover-orbit::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; pointer-events: none; }
  .discover-orbit::before { border: 1px solid #b3c9df45; opacity: calc(1 - var(--discover-active)); transform: scale(calc(1 - .25 * var(--discover-active))); transition: opacity .3s, transform .4s var(--ease-ui); }
  .discover-orbit::after { border: 1px solid #d6b881b3; opacity: var(--discover-active); transform: scale(calc(1.2 - .2 * var(--discover-active))); transition: opacity .3s .04s, transform .4s var(--ease-ui) .04s; }
  .discover-track { position: absolute; z-index: 1; inset: 0 0 auto; display: flex; flex-direction: column; height: 200%; transform: translateY(calc(-50% + 50% * var(--discover-active))); transition: transform .4s var(--ease-ui); }
  .discover-icon { display: grid; place-items: center; flex: 0 0 50%; }
  .hero-discover:focus-visible { --discover-active: 1; color: #eeeae1; outline: 2px solid var(--gold); outline-offset: 5px; }
  @media (hover: hover) and (pointer: fine) { .hero-discover:hover { --discover-active: 1; color: #eeeae1; } }
  .hero-discover:active { --discover-active: 1; transform: translateY(1px); }
  :global(html.is-paused) .discover-orbit::before, :global(html.is-paused) .discover-orbit::after, :global(html.is-paused) .discover-track { transition: none; }
  @media (max-width: 720px) {
    .hero-actions { gap: 10px 18px; margin-top: 26px; }
    .hero-discover { min-height: 48px; gap: 10px; font-size: 13px; }
    .discover-orbit { width: 36px; height: 36px; }
  }
  @media (max-height: 500px) and (min-width: 600px) and (max-width: 1100px) {
    .hero-actions { gap: 10px 18px; margin-top: 20px; }
    .hero-actions :global(.star-link.is-primary) { min-height: 44px; min-width: 140px; padding: 10px 16px; font-size: 12px; }
    .hero-discover { min-height: 44px; font-size: 12px; }
    .discover-orbit { width: 36px; height: 36px; }
  }
</style>
