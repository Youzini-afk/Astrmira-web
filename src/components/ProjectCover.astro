---
/* Animated covers for the project cards. One gold point is the active intelligence,
   the blue structure is the system it works through:
   - TriviumDB: a query finds its neighbours, links them as a graph, opens the document.
   - infOS: one continuous thread passes its memories and recalls earlier ones.
   - Varin: an agent visits model, tools, files and project; every visit is logged.
   The resting frame is the composed scene, so no script, a paused page and reduced
   motion all show a complete picture. Animation runs only while the cover is on screen. */
interface Props { kind: 'trivium' | 'infos' | 'varin' }
const { kind } = Astro.props;

const rng = (seed: number) => () => {
  seed = (seed + 0x6D2B79F5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const f = (n: number) => n.toFixed(1);

// TriviumDB: three clusters of embeddings, one query, its six nearest neighbours.
const trivium = (() => {
  const rand = rng(7);
  const gauss = () => { let u = 0; while (!u) u = rand(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * rand()); };
  const points: number[][] = [];
  for (const [cx, cy, s] of [[90, 86, 23], [160, 156, 25], [216, 90, 21]]) {
    for (let i = 0; i < 26; i++) {
      const x = cx + gauss() * s, y = cy + gauss() * s * .8;
      if (x > 36 && x < 252 && y > 30 && y < 216) points.push([x, y]);
    }
  }
  for (let i = 0; i < 12; i++) points.push([40 + rand() * 210, 34 + rand() * 178]);
  const q = [176, 120];
  const ranked = points.map((p, i) => ({ i, d: Math.hypot(p[0] - q[0], p[1] - q[1]) })).sort((a, b) => a.d - b.d);
  const hitIndex = new Set(ranked.slice(0, 6).map(r => r.i));
  const hits = ranked.slice(0, 6).map(r => points[r.i]);
  const keys = new Set<string>();
  hits.forEach((p, a) => {
    hits.map((o, b) => ({ b, d: Math.hypot(p[0] - o[0], p[1] - o[1]) })).filter(e => e.b !== a)
      .sort((x, y) => x.d - y.d).slice(0, 2).forEach(e => keys.add([Math.min(a, e.b), Math.max(a, e.b)].join('-')));
  });
  const graph = [...keys].map(k => k.split('-').map(Number)).map(([a, b]) => `M${f(hits[a][0])} ${f(hits[a][1])}L${f(hits[b][0])} ${f(hits[b][1])}`);
  const top = hits[0];
  const field = points.map((p, i) => ({ p, hit: hitIndex.has(i), twinkle: !hitIndex.has(i) && i % 4 === 0, delay: (i * .37) % 4.6 }));
  return {
    field, q, hits, graph, radius: ranked[5].d + 7,
    lead: `M${f(top[0])} ${f(top[1])}C${f(top[0] + 46)} ${f(top[1])} 240 120 276 120`,
    lines: [34, 52, 44, 50, 38, 46]
  };
})();

// infOS: a lemniscate traced as one continuous thread; beads are retained memories.
const infos = (() => {
  const cx = 190, cy = 125, a = 142, stretch = 1.3, n = 200, pts: number[][] = [];
  for (let k = 0; k < n; k++) {
    const t = k / n * Math.PI * 2, s = Math.sin(t), den = 1 + s * s;
    pts.push([cx + a * Math.cos(t) / den, cy + a * stretch * s * Math.cos(t) / den]);
  }
  const lens = [0];
  for (let k = 1; k <= n; k++) { const p = pts[k % n], o = pts[k - 1]; lens.push(lens[k - 1] + Math.hypot(p[0] - o[0], p[1] - o[1])); }
  const total = lens[n];
  // Position at a fraction of the arc length, matching pathLength="1000" in the browser.
  const at = (fr: number) => {
    const target = fr * total, k = Math.max(1, lens.findIndex(l => l >= target));
    const p0 = pts[(k - 1) % n], p1 = pts[k % n], u = (target - lens[k - 1]) / (lens[k] - lens[k - 1] || 1);
    return [p0[0] + (p1[0] - p0[0]) * u, p0[1] + (p1[1] - p0[1]) * u];
  };
  const beads = [.06, .15, .31, .4, .56, .65, .81, .9].map(fr => ({ fr, p: at(fr) }));
  const recalls = [[5, 1], [7, 3]].map(([from, to]) => {
    const p = beads[from].p, o = beads[to].p, mx = (p[0] + o[0]) / 2, my = Math.min(p[1], o[1]) - 46;
    return { fr: beads[from].fr, end: o, d: `M${f(p[0])} ${f(p[1])}Q${f(mx)} ${f(my)} ${f(o[0])} ${f(o[1])}` };
  });
  const trails = [
    { len: 230, cls: 'i-trail-far' }, { len: 110, cls: 'i-trail-mid' },
    { len: 40, cls: 'i-trail-near' }, { len: .6, cls: 'i-head' }
  ];
  return { d: 'M' + pts.map(p => `${f(p[0])} ${f(p[1])}`).join('L') + 'Z', beads, recalls, trails, cx, cy };
})();

// Varin: one loop through four stations; the log on the right keeps every visit.
const varin = (() => {
  const c = [124, 125], r = 76, rowH = 24, visible = 6, top = 52;
  const glyphs = [
    'M6.5 0A6.5 6.5 0 1 1-6.5 0A6.5 6.5 0 1 1 6.5 0ZM1.8 0A1.8 1.8 0 1 1-1.8 0A1.8 1.8 0 1 1 1.8 0Z',
    'M-5.5-5.5H5.5V5.5H-5.5ZM-2.5 0H2.5',
    'M-5-6.5H1.5L5-3V6.5H-5ZM1.5-6.5V-3H5',
    'M0-7L7 0L0 7L-7 0Z'
  ];
  const stations = [-90, 0, 90, 180].map((deg, i) => {
    const a = deg * Math.PI / 180;
    return { i, x: c[0] + Math.cos(a) * r, y: c[1] + Math.sin(a) * r, glyph: glyphs[i] };
  });
  // Rows repeat every four visits, so the log can scroll forever without a visible seam.
  const widths = [[46, 0], [38, 26], [52, 0], [30, 40]];
  const rows = Array.from({ length: visible + 4 }, (_, j) => {
    const s = ((j - (visible - 1)) % 4 + 4) % 4;
    return { s, y: top + j * rowH, glyph: glyphs[s], w: widths[s] };
  });
  const trailStart = -118 * Math.PI / 180;
  return {
    c, r, stations, rows,
    window: { x: 234, y: top - 14, w: 116, h: visible * rowH + 2 },
    trail: `M${f(c[0] + Math.cos(trailStart) * r)} ${f(c[1] + Math.sin(trailStart) * r)}A${r} ${r} 0 0 1 ${f(c[0])} ${f(c[1] - r)}`
  };
})();
---

<svg class={`cover cover-${kind}`} viewBox="0 0 380 250" fill="none" aria-hidden="true" data-project-cover>
  {kind === 'trivium' && <>
    {trivium.field.map(({ p, twinkle, delay }) =>
      <circle class:list={['t-pt', { 't-twinkle': twinkle }]} cx={f(p[0])} cy={f(p[1])} r="1.6" style={`--d:${delay.toFixed(2)}s`} />)}
    <circle class="t-ring" cx={trivium.q[0]} cy={trivium.q[1]} r={f(trivium.radius)} />
    {trivium.graph.map((d, i) => <path class="t-edge" d={d} pathLength="1" style={`--i:${i}`} />)}
    {trivium.hits.map((p, i) => <circle class="t-hit" cx={f(p[0])} cy={f(p[1])} r={i === 0 ? 3.2 : 2.6} style={`--i:${i}`} />)}
    <circle class="t-query" cx={trivium.q[0]} cy={trivium.q[1]} r="3" />
    <path class="t-lead" d={trivium.lead} pathLength="1" />
    <g class="t-doc">
      <path class="t-sheet" d="M276 64H336L348 76V176H276Z" />
      <path class="t-sheet" d="M336 64V76H348" />
      <path class="t-title" d="M286 80H320" pathLength="1" />
      {trivium.lines.map((w, i) => <path class="t-line" d={`M286 ${96 + i * 13}H${286 + w}`} pathLength="1" style={`--i:${i}`} />)}
    </g>
  </>}

  {kind === 'infos' && <>
    <path class="i-track" d={infos.d} />
    {infos.recalls.map(r => <>
      <path class="i-recall" d={r.d} pathLength="1" style={`--d:${(r.fr * 7).toFixed(2)}s`} />
      <circle class="i-recalled" cx={f(r.end[0])} cy={f(r.end[1])} r="5.5" style={`--d:${(r.fr * 7).toFixed(2)}s`} />
    </>)}
    {infos.beads.map(b => <>
      <circle class="i-bead" cx={f(b.p[0])} cy={f(b.p[1])} r="2.2" />
      <circle class="i-memory" cx={f(b.p[0])} cy={f(b.p[1])} r="3.6" style={`--d:${(b.fr * 7).toFixed(2)}s`} />
    </>)}
    {infos.trails.map(t => <path class={`i-trail ${t.cls}`} d={infos.d} pathLength="1000"
      style={`stroke-dasharray:${t.len} ${1000 - t.len};--from:${t.len};--to:${t.len - 1000}`} />)}
    <circle class="i-self-ring" cx={infos.cx} cy={infos.cy} r="8" />
    <circle class="i-self" cx={infos.cx} cy={infos.cy} r="2.4" />
  </>}

  {kind === 'varin' && <>
    <defs>
      <linearGradient id="varin-log-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".22" stop-color="#fff" /><stop offset="1" stop-color="#fff" />
      </linearGradient>
      <mask id="varin-log-mask"><rect x={varin.window.x} y={varin.window.y} width={varin.window.w} height={varin.window.h} fill="url(#varin-log-fade)" /></mask>
    </defs>
    <circle class="v-orbit" cx={varin.c[0]} cy={varin.c[1]} r={varin.r} />
    {varin.stations.map(s => <path class="v-spoke" d={`M${varin.c[0]} ${varin.c[1]}L${f(s.x)} ${f(s.y)}`} />)}
    {varin.stations.map(s => <path class:list={['v-spoke-lit', { 'is-current': s.i === 0 }]} d={`M${varin.c[0]} ${varin.c[1]}L${f(s.x)} ${f(s.y)}`} style={`--i:${s.i}`} />)}
    <circle class="v-core-ring" cx={varin.c[0]} cy={varin.c[1]} r="11" />
    <circle class="v-core" cx={varin.c[0]} cy={varin.c[1]} r="2.4" />
    {varin.stations.map(s => <g transform={`translate(${f(s.x)} ${f(s.y)})`}>
      <circle class="v-pad" r="11" />
      <path class="v-glyph" d={s.glyph} />
      <g class:list={['v-lit', { 'is-current': s.i === 0 }]} style={`--i:${s.i}`}>
        <circle class="v-halo" r="13" />
        <path class="v-glyph-lit" d={s.glyph} />
      </g>
    </g>)}
    <g class="v-agent">
      <path class="v-agent-trail" d={varin.trail} />
      <circle class="v-agent-dot" cx={varin.c[0]} cy={varin.c[1] - varin.r} r="3.2" />
    </g>
    <path class="v-divider" d="M220 48V202" />
    <g mask="url(#varin-log-mask)">
      <g class="v-log">
        {varin.rows.map(row => <g>
          <path class="v-row-glyph" d={row.glyph} transform={`translate(246 ${row.y}) scale(.62)`} />
          <path class="v-bar" d={`M258 ${row.y}H${258 + row.w[0]}`} />
          {row.w[1] > 0 && <path class="v-bar v-bar-soft" d={`M258 ${row.y + 8}H${258 + row.w[1]}`} />}
        </g>)}
      </g>
    </g>
  </>}
</svg>

<style>
  .cover { overflow: visible; }

  /* ---------- TriviumDB: query, neighbours, graph, document (9s) ---------- */
  .t-pt { fill: var(--blue); opacity: .55; }
  .t-ring { fill: var(--gold); fill-opacity: .05; stroke: var(--gold); stroke-opacity: .5; stroke-width: .8; transform-box: fill-box; transform-origin: center; }
  .t-query { fill: var(--gold); }
  .t-hit { fill: var(--gold); transform-box: fill-box; transform-origin: center; }
  .t-edge { stroke: var(--gold); stroke-opacity: .65; stroke-width: .9; stroke-dasharray: 1 2; }
  .t-lead { stroke: var(--blue); stroke-opacity: .55; stroke-width: .8; stroke-dasharray: 1 2; }
  .t-sheet { stroke: var(--blue); stroke-opacity: .6; stroke-width: .8; }
  .t-title { stroke: var(--gold); stroke-opacity: .8; stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1 2; }
  .t-line { stroke: var(--blue); stroke-opacity: .45; stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1 2; }

  .is-live .t-twinkle { animation: t-twinkle 4.6s ease-in-out var(--d) infinite alternate; }
  .is-live .t-ring { animation: t-ring 9s cubic-bezier(.3, .7, .2, 1) infinite; }
  .is-live .t-query { animation: t-query 9s ease infinite; }
  .is-live .t-hit { animation: t-hit 9s cubic-bezier(.3, .7, .2, 1) calc(var(--i) * 90ms) infinite; }
  .is-live .t-edge { animation: t-edge 9s ease-out calc(var(--i) * 110ms) infinite; }
  .is-live .t-lead { animation: t-lead 9s ease-out infinite; }
  .is-live .t-doc { animation: t-doc 9s cubic-bezier(.3, .7, .2, 1) infinite; }
  .is-live .t-title, .is-live .t-line { animation: t-write 9s ease-out calc(var(--i, -1) * 90ms + 90ms) infinite; }

  @keyframes t-twinkle { from { opacity: .55; } to { opacity: .15; } }
  @keyframes t-ring { 0%, 12% { opacity: 1; transform: scale(1); } 20%, 29% { opacity: 0; transform: scale(.2); } 40%, 100% { opacity: 1; transform: scale(1); } }
  @keyframes t-query { 0%, 12% { opacity: 1; } 19%, 26% { opacity: 0; } 30%, 100% { opacity: 1; } }
  @keyframes t-hit { 0%, 12% { opacity: 1; transform: scale(1); } 19%, 39% { opacity: 0; transform: scale(.3); } 45%, 100% { opacity: 1; transform: scale(1); } }
  @keyframes t-edge { 0%, 12% { opacity: 1; stroke-dashoffset: 0; } 18% { opacity: 0; stroke-dashoffset: 0; } 19%, 46% { opacity: 0; stroke-dashoffset: 1; } 47% { opacity: 1; stroke-dashoffset: 1; } 56%, 100% { opacity: 1; stroke-dashoffset: 0; } }
  @keyframes t-lead { 0%, 12% { opacity: 1; stroke-dashoffset: 0; } 18% { opacity: 0; stroke-dashoffset: 0; } 19%, 55% { opacity: 0; stroke-dashoffset: 1; } 56% { opacity: 1; stroke-dashoffset: 1; } 63%, 100% { opacity: 1; stroke-dashoffset: 0; } }
  @keyframes t-doc { 0%, 12% { opacity: 1; transform: none; } 18%, 60% { opacity: 0; transform: translateX(-8px); } 66%, 100% { opacity: 1; transform: none; } }
  @keyframes t-write { 0%, 12% { stroke-dashoffset: 0; } 18%, 64% { stroke-dashoffset: 1; } 72%, 100% { stroke-dashoffset: 0; } }

  /* ---------- infOS: one thread, retained and recalled memories (7s) ---------- */
  .i-track { stroke: var(--blue); stroke-opacity: .24; stroke-width: .8; }
  .i-trail { fill: none; stroke-linecap: round; stroke-dashoffset: var(--from); }
  .i-trail-far { stroke: var(--blue); stroke-opacity: .28; stroke-width: 1; }
  .i-trail-mid { stroke: var(--blue); stroke-opacity: .5; stroke-width: 1.3; }
  .i-trail-near { stroke: var(--gold); stroke-opacity: .8; stroke-width: 1.6; }
  .i-head { stroke: var(--gold); stroke-width: 5; }
  .i-bead { fill: var(--blue); opacity: .65; }
  .i-memory { fill: var(--gold); opacity: .22; transform-box: fill-box; transform-origin: center; }
  .i-recall { stroke: var(--gold); stroke-opacity: .6; stroke-width: .9; stroke-dasharray: 1 2; stroke-dashoffset: 1; opacity: 0; }
  .i-recalled { stroke: var(--gold); stroke-opacity: .7; stroke-width: .7; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .i-self { fill: var(--gold); }
  .i-self-ring { stroke: var(--gold); stroke-opacity: .35; stroke-width: .7; transform-box: fill-box; transform-origin: center; }

  .is-live .i-trail { animation: i-travel 7s linear infinite; }
  .is-live .i-memory { animation: i-pass 7s ease-out var(--d) infinite; }
  .is-live .i-recall { animation: i-recall 7s ease-out var(--d) infinite; }
  .is-live .i-recalled { animation: i-recalled 7s ease-out var(--d) infinite; }
  .is-live .i-self-ring { animation: i-breathe 3.5s ease-in-out infinite alternate; }

  @keyframes i-travel { from { stroke-dashoffset: var(--from); } to { stroke-dashoffset: var(--to); } }
  @keyframes i-pass { 0% { opacity: 1; transform: scale(1.6); } 14% { opacity: .5; transform: scale(1); } 100% { opacity: .16; transform: scale(1); } }
  @keyframes i-recall { 0% { opacity: 1; stroke-dashoffset: 1; } 10% { stroke-dashoffset: 0; } 22% { opacity: .8; stroke-dashoffset: 0; } 34%, 100% { opacity: 0; stroke-dashoffset: 0; } }
  @keyframes i-recalled { 0%, 8% { opacity: 0; transform: scale(.6); } 11% { opacity: .9; transform: scale(1); } 30%, 100% { opacity: 0; transform: scale(1.9); } }
  @keyframes i-breathe { from { transform: scale(.8); opacity: .6; } to { transform: scale(1.15); opacity: 1; } }

  /* ---------- Varin: the agent loop and its log (8s, four 2s visits) ---------- */
  .v-orbit { stroke: var(--blue); stroke-opacity: .28; stroke-width: .8; }
  .v-spoke { stroke: var(--blue); stroke-opacity: .14; stroke-width: .7; }
  .v-spoke-lit { stroke: var(--gold); stroke-opacity: .6; stroke-width: .8; opacity: 0; }
  .v-core-ring { stroke: var(--gold); stroke-opacity: .4; stroke-width: .7; }
  .v-core { fill: var(--gold); }
  .v-pad { fill: var(--bg); }
  .v-glyph { stroke: var(--blue); stroke-opacity: .75; stroke-width: .9; stroke-linejoin: round; }
  .v-lit { opacity: 0; }
  .v-halo { stroke: var(--gold); stroke-opacity: .3; stroke-width: .7; }
  .v-glyph-lit { stroke: var(--gold); stroke-width: .9; stroke-linejoin: round; }
  .v-spoke-lit.is-current, .v-lit.is-current { opacity: 1; }
  .v-agent { transform-box: view-box; transform-origin: 124px 125px; }
  .v-agent-trail { stroke: var(--gold); stroke-opacity: .35; stroke-width: 1.4; stroke-linecap: round; }
  .v-agent-dot { fill: var(--gold); }
  .v-divider { stroke: var(--blue); stroke-opacity: .1; stroke-width: .7; }
  .v-row-glyph { stroke: var(--blue); stroke-opacity: .65; stroke-width: .9; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .v-bar { stroke: var(--blue); stroke-opacity: .42; stroke-width: 3; stroke-linecap: round; }
  .v-bar-soft { stroke-opacity: .24; }

  .is-live .v-agent { animation: v-run 8s cubic-bezier(.6, 0, .3, 1) infinite; }
  .is-live .v-lit, .is-live .v-spoke-lit { animation: v-visit 8s ease calc(var(--i) * 2s) infinite; }
  .is-live .v-log { animation: v-scroll 8s cubic-bezier(.6, 0, .3, 1) infinite; }

  @keyframes v-run { 0%, 17.5% { transform: rotate(0deg); } 25%, 42.5% { transform: rotate(90deg); } 50%, 67.5% { transform: rotate(180deg); } 75%, 92.5% { transform: rotate(270deg); } 100% { transform: rotate(360deg); } }
  @keyframes v-visit { 0%, 17.5% { opacity: 1; } 23%, 100% { opacity: 0; } }
  @keyframes v-scroll { 0%, 17.5% { transform: translateY(0); } 25%, 42.5% { transform: translateY(-24px); } 50%, 67.5% { transform: translateY(-48px); } 75%, 92.5% { transform: translateY(-72px); } 100% { transform: translateY(-96px); } }

  /* A paused page and reduced motion both show the composed frame. */
  :global(html.is-paused) .cover *, :global(html.is-paused) .cover { animation: none !important; }
  @media (prefers-reduced-motion: reduce) { .cover, .cover * { animation: none !important; } }
</style>
