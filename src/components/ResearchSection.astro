---
// ResearchSection.astro: Verifiable principles and interactive research exploration
---

<section class="research-section" id="research">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <div class="eyebrow">
          <span class="index">02</span>
          <span>INSIDE THE RESEARCH</span>
        </div>
        <h3 class="section-title">让原理，变得可见。</h3>
        <p class="sub">不止于一个结论。也关乎它如何被理解、检验与复现。</p>
      </div>
      <a href="/research" class="text-link">
        进入 Research <span class="arrow">&nearr;</span>
      </a>
    </div>

    <!-- Lab Tabs -->
    <div class="lab-tabs" role="tablist" aria-label="研究交互演示">
      <button class="lab-tab is-active" id="tab-btn-vector" data-tab="vector" role="tab" aria-selected="true" aria-controls="panel-vector">
        <span>01</span> 向量检索
      </button>
      <button class="lab-tab" id="tab-btn-quant" data-tab="quant" role="tab" aria-selected="false" aria-controls="panel-quant">
        <span>02</span> 量化表示
      </button>
      <button class="lab-tab" id="tab-btn-agent" data-tab="agent" role="tab" aria-selected="false" aria-controls="panel-agent">
        <span>03</span> Agent 闭环
      </button>
    </div>

    <!-- Panel 1: Vector Nearest Neighbor -->
    <div class="lab-panel" id="panel-vector" role="tabpanel" aria-labelledby="tab-btn-vector">
      <div class="lab-visual">
        <canvas id="vector-canvas" width="560" height="320"></canvas>
        <div class="lab-visual-footer">
          <div class="plot-legend">
            <span class="legend-data">DATA POINTS</span>
            <span class="legend-probe">QUERY PROBE</span>
            <span class="legend-nn">TOP-5 NEIGHBORS</span>
          </div>
          <span>2D CONCEPTUAL EMBEDDING SPACE</span>
        </div>
      </div>

      <div class="lab-copy">
        <div class="eyebrow">FIND THE RELEVANT</div>
        <h4 class="lab-title">在数据之间，找到真正的邻近。</h4>
        <p class="lab-desc">
          从查询点出发，在连续嵌入空间中度量几何距离。拖动下方滑块或直接在左侧画布悬停，观察近邻点集与拓扑图路径的实时变化。
        </p>

        <div class="lab-controls">
          <label for="query-slider">移动查询点：</label>
          <input type="range" id="query-slider" min="60" max="500" value="280">
          <output id="query-out">280</output>
        </div>

        <div class="lab-metrics-row">
          <div class="metric-item">
            <span class="metric-label">TOP-1 DISTANCE</span>
            <span class="metric-val" id="metric-dist">0.042</span>
          </div>
          <div class="metric-item">
            <span class="metric-label">GRAPH HOPS</span>
            <span class="metric-val">3 HOPS</span>
          </div>
          <div class="metric-item">
            <span class="metric-label">INDEX COMPLEXITY</span>
            <span class="metric-val">O(log N)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 2: Quantization -->
    <div class="lab-panel" id="panel-quant" role="tabpanel" aria-labelledby="tab-btn-quant" hidden>
      <div class="lab-visual">
        <canvas id="quant-canvas" width="560" height="320"></canvas>
        <div class="lab-visual-footer">
          <div class="plot-legend">
            <span class="legend-data">CONTINUOUS SIGNAL</span>
            <span class="legend-nn">DISCRETE CODEBOOK</span>
          </div>
          <span>RECONSTRUCTION ERROR MONITOR</span>
        </div>
      </div>

      <div class="lab-copy">
        <div class="eyebrow">EFFICIENCY & FIDELITY</div>
        <h4 class="lab-title">以极小比特，保留最大的信息量。</h4>
        <p class="lab-desc">
          在千亿参数与海量向量检索中，量化是将理论算法推向超低延迟系统的关键阶梯。调节量化位宽，直观观察精度与压缩比的 Pareto 边界。
        </p>

        <div class="lab-controls">
          <label for="bits-slider">量化位宽 (Bits)：</label>
          <input type="range" id="bits-slider" min="2" max="8" value="4" step="1">
          <output id="bits-out">4-bit</output>
        </div>

        <div class="lab-metrics-row">
          <div class="metric-item">
            <span class="metric-label">COMPRESSION RATIO</span>
            <span class="metric-val" id="metric-ratio">8.0x</span>
          </div>
          <div class="metric-item">
            <span class="metric-label">MSE DISTORTION</span>
            <span class="metric-val" id="metric-mse">0.0124</span>
          </div>
          <div class="metric-item">
            <span class="metric-label">MEMORY FOOTPRINT</span>
            <span class="metric-val">12.5%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 3: Agent Closed Loop -->
    <div class="lab-panel" id="panel-agent" role="tabpanel" aria-labelledby="tab-btn-agent" hidden>
      <div class="lab-visual">
        <canvas id="agent-canvas" width="560" height="320"></canvas>
        <div class="lab-visual-footer">
          <div class="plot-legend">
            <span class="legend-data">TOOL DISPATCH</span>
            <span class="legend-probe">REFLECTION GATE</span>
          </div>
          <span>AUTONOMOUS EXECUTION TRAJECTORY</span>
        </div>
      </div>

      <div class="lab-copy">
        <div class="eyebrow">ACTION & VERIFICATION</div>
        <h4 class="lab-title">从意图出发，在闭环中收敛。</h4>
        <p class="lab-desc">
          真正的 Agent 不是无头绪的文本输出，而是在沙箱与真实环境中调用工具、观测反馈、形式化反思与自我纠错的闭环系统。
        </p>

        <div class="lab-controls">
          <button class="button button-quiet" id="btn-agent-pulse">
            <span>&rtrif; 发起单步推演脉冲</span>
          </button>
        </div>

        <div class="lab-metrics-row">
          <div class="metric-item">
            <span class="metric-label">CYCLE STATUS</span>
            <span class="metric-val" id="agent-cycle-status">VERIFIED</span>
          </div>
          <div class="metric-item">
            <span class="metric-label">SUCCESS RATE</span>
            <span class="metric-val">99.2%</span>
          </div>
          <div class="metric-item">
            <span class="metric-label">SANDBOX LATENCY</span>
            <span class="metric-val">18 ms</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom domain tags -->
    <div class="research-bottom">
      <div class="topic-list">
        <span class="tag">数据库系统</span>
        <span class="tag">向量检索</span>
        <span class="tag">量化表示</span>
        <span class="tag">后训练对齐</span>
        <span class="tag">非凸数学</span>
        <span class="tag">自主协同</span>
      </div>
      <span class="tiny-note">交互式概念示意 · 基于真实理论模型构建</span>
    </div>
  </div>
</section>

<style>
  .research-section {
    background: linear-gradient(rgba(16, 22, 32, 0.75), rgba(13, 18, 27, 0.9));
    border-block: 1px solid var(--line);
    padding-block: 100px;
    position: relative;
    z-index: 5;
  }

  .lab-tabs {
    display: flex;
    gap: 36px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0;
  }

  .lab-tab {
    padding: 0 4px 18px;
    font-size: 13px;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    position: relative;
    bottom: -1px;
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s;
  }

  .lab-tab span {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--faint);
    margin-right: 8px;
  }

  .lab-tab:hover {
    color: var(--text);
  }

  .lab-tab.is-active {
    color: var(--text);
    border-color: var(--gold);
  }

  .lab-tab.is-active span {
    color: var(--gold);
  }

  .lab-panel {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    min-height: 420px;
    border-bottom: 1px solid var(--line);
    background: rgba(8, 11, 17, 0.5);
  }

  .lab-visual {
    border-right: 1px solid var(--line);
    padding: 24px 28px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  .lab-visual canvas {
    width: 100%;
    height: 300px;
    display: block;
    cursor: crosshair;
  }

  .lab-visual-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--faint);
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .plot-legend {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .plot-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .plot-legend span::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .legend-data::before { background: #6a7890; }
  .legend-probe::before { background: var(--gold); box-shadow: 0 0 6px var(--gold); }
  .legend-nn::before { background: #91b9d5; }

  .lab-copy {
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lab-title {
    font-size: 24px;
    letter-spacing: 0.03em;
    line-height: 1.5;
    margin: 12px 0 14px;
  }

  .lab-desc {
    font-size: 13px;
    line-height: 1.95;
    color: var(--muted);
  }

  .lab-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
    font-size: 12px;
    color: var(--muted);
    flex-wrap: wrap;
  }

  .lab-controls input[type="range"] {
    accent-color: var(--gold);
    width: 160px;
    cursor: pointer;
  }

  .lab-controls output {
    font-family: var(--mono);
    color: var(--gold);
    font-size: 11px;
    min-width: 32px;
  }

  .lab-metrics-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-label {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--faint);
    letter-spacing: 0.06em;
  }

  .metric-val {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--text);
    font-weight: 500;
  }

  .research-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .topic-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .lab-panel {
      grid-template-columns: 1fr;
    }
    .lab-visual {
      border-right: none;
      border-bottom: 1px solid var(--line);
      padding: 20px 10px;
    }
    .lab-copy {
      padding: 30px 16px;
    }
  }
</style>

<script>
  // Lab Tab Switcher & Dynamic Canvas Renderers
  (function initLab() {
    const tabs = document.querySelectorAll('.lab-tab');
    const panels = document.querySelectorAll('.lab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetTab = tab.getAttribute('data-tab');
        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === `panel-${targetTab}`) {
            p.removeAttribute('hidden');
          } else {
            p.setAttribute('hidden', '');
          }
        });
      });
    });

    // 1. Vector Nearest Neighbor Canvas
    const vCanvas = document.getElementById('vector-canvas') as HTMLCanvasElement;
    if (vCanvas) {
      const ctx = vCanvas.getContext('2d');
      const w = vCanvas.width;
      const h = vCanvas.height;

      // Seeded point cloud
      let points: Array<{ x: number; y: number; r: number }> = [];
      for (let i = 0; i < 70; i++) {
        points.push({
          x: 40 + Math.random() * (w - 80),
          y: 30 + Math.random() * (h - 60),
          r: 2.2 + Math.random() * 1.5
        });
      }

      let probeX = 280;
      let probeY = 160;

      function drawVector() {
        if (!ctx) return;
        ctx.clearRect(0, 0, w, h);

        // Background subtle grid
        ctx.strokeStyle = 'rgba(179, 195, 219, 0.05)';
        ctx.lineWidth = 1;
        for (let x = 0; x < w; x += 40) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
        }
        for (let y = 0; y < h; y += 40) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
        }

        // Compute distances to probe
        const dists = points.map(p => {
          const dx = p.x - probeX;
          const dy = p.y - probeY;
          return { p, dist: Math.sqrt(dx * dx + dy * dy) };
        });
        dists.sort((a, b) => a.dist - b.dist);
        const topK = dists.slice(0, 5);

        // Draw connecting filaments to Top-5
        topK.forEach((item, idx) => {
          ctx.save();
          ctx.strokeStyle = idx === 0 ? 'rgba(214, 184, 129, 0.8)' : 'rgba(145, 185, 213, 0.5)';
          ctx.lineWidth = idx === 0 ? 1.5 : 1;
          ctx.setLineDash(idx === 0 ? [] : [3, 4]);
          ctx.beginPath();
          ctx.moveTo(probeX, probeY);
          ctx.lineTo(item.p.x, item.p.y);
          ctx.stroke();
          ctx.restore();
        });

        // Draw points
        points.forEach(p => {
          const isTop = topK.some(t => t.p === p);
          ctx.fillStyle = isTop ? '#91b9d5' : '#49576a';
          ctx.beginPath();
          ctx.arc(p.x, p.y, isTop ? p.r + 1.2 : p.r, 0, Math.PI * 2);
          ctx.fill();
        });

        // Draw Query Probe
        ctx.save();
        ctx.fillStyle = '#d6b881';
        ctx.shadowColor = 'rgba(214, 184, 129, 0.6)';
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.arc(probeX, probeY, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        // Update metric
        const distEl = document.getElementById('metric-dist');
        if (distEl && topK.length > 0) {
          distEl.textContent = (topK[0].dist / 1000).toFixed(4);
        }
      }

      drawVector();

      // Slider & Hover bindings
      const slider = document.getElementById('query-slider') as HTMLInputElement;
      const sliderOut = document.getElementById('query-out');
      if (slider) {
        slider.addEventListener('input', () => {
          probeX = Number(slider.value);
          if (sliderOut) sliderOut.textContent = String(probeX);
          drawVector();
        });
      }

      vCanvas.addEventListener('mousemove', (e) => {
        const rect = vCanvas.getBoundingClientRect();
        const scaleX = w / rect.width;
        const scaleY = h / rect.height;
        probeX = (e.clientX - rect.left) * scaleX;
        probeY = (e.clientY - rect.top) * scaleY;
        if (slider) slider.value = String(Math.round(probeX));
        if (sliderOut) sliderOut.textContent = String(Math.round(probeX));
        drawVector();
      });
    }

    // 2. Quantization Canvas
    const qCanvas = document.getElementById('quant-canvas') as HTMLCanvasElement;
    if (qCanvas) {
      const ctx = qCanvas.getContext('2d');
      const w = qCanvas.width;
      const h = qCanvas.height;
      let bits = 4;

      function drawQuant() {
        if (!ctx) return;
        ctx.clearRect(0, 0, w, h);

        const levels = Math.pow(2, bits);
        const stepY = (h - 80) / levels;

        // Draw Continuous Sine Wave
        ctx.save();
        ctx.strokeStyle = '#49576a';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        for (let x = 40; x < w - 40; x++) {
          const y = h * 0.5 + Math.sin(x * 0.02) * (h * 0.35);
          if (x === 40) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
        ctx.restore();

        // Draw Quantized Stepped Signal
        ctx.save();
        ctx.strokeStyle = '#d6b881';
        ctx.lineWidth = 2;
        ctx.shadowColor = 'rgba(214, 184, 129, 0.4)';
        ctx.shadowBlur = 6;
        ctx.beginPath();
        for (let x = 40; x < w - 40; x += 4) {
          const rawY = h * 0.5 + Math.sin(x * 0.02) * (h * 0.35);
          const levelIdx = Math.round((rawY - 40) / stepY);
          const quantY = 40 + levelIdx * stepY;
          if (x === 40) ctx.moveTo(x, quantY);
          else ctx.lineTo(x, quantY);
        }
        ctx.stroke();
        ctx.restore();
      }

      drawQuant();

      const bitsSlider = document.getElementById('bits-slider') as HTMLInputElement;
      const bitsOut = document.getElementById('bits-out');
      const ratioEl = document.getElementById('metric-ratio');
      const mseEl = document.getElementById('metric-mse');

      if (bitsSlider) {
        bitsSlider.addEventListener('input', () => {
          bits = Number(bitsSlider.value);
          if (bitsOut) bitsOut.textContent = `${bits}-bit`;
          if (ratioEl) ratioEl.textContent = `${(32 / bits).toFixed(1)}x`;
          if (mseEl) mseEl.textContent = (0.2 / Math.pow(2, bits)).toFixed(4);
          drawQuant();
        });
      }
    }

    // 3. Agent Pulse Canvas
    const aCanvas = document.getElementById('agent-canvas') as HTMLCanvasElement;
    if (aCanvas) {
      const ctx = aCanvas.getContext('2d');
      const w = aCanvas.width;
      const h = aCanvas.height;

      const nodes = [
        { label: 'INTENT', x: 80, y: 160 },
        { label: 'PLANNER', x: 200, y: 90 },
        { label: 'TOOL EXEC', x: 340, y: 90 },
        { label: 'REFLECT', x: 270, y: 230 }
      ];

      let progress = 0;
      function renderAgent() {
        if (!ctx) return;
        ctx.clearRect(0, 0, w, h);

        // Connective loop lines
        ctx.save();
        ctx.strokeStyle = 'rgba(145, 185, 213, 0.3)';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(nodes[0].x, nodes[0].y);
        ctx.lineTo(nodes[1].x, nodes[1].y);
        ctx.lineTo(nodes[2].x, nodes[2].y);
        ctx.lineTo(nodes[3].x, nodes[3].y);
        ctx.closePath();
        ctx.stroke();

        // Draw Nodes
        nodes.forEach(n => {
          ctx.fillStyle = '#10141c';
          ctx.strokeStyle = '#d6b881';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(n.x, n.y, 16, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();

          ctx.font = '10px monospace';
          ctx.fillStyle = '#eeeae1';
          ctx.textAlign = 'center';
          ctx.fillText(n.label, n.x, n.y + 32);
        });

        // Pulsing token
        progress = (progress + 0.01) % 4;
        const currentIdx = Math.floor(progress);
        const nextIdx = (currentIdx + 1) % 4;
        const t = progress - currentIdx;

        const pX = nodes[currentIdx].x + (nodes[nextIdx].x - nodes[currentIdx].x) * t;
        const pY = nodes[currentIdx].y + (nodes[nextIdx].y - nodes[currentIdx].y) * t;

        ctx.fillStyle = '#d6b881';
        ctx.shadowColor = '#d6b881';
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.arc(pX, pY, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        requestAnimationFrame(renderAgent);
      }
      renderAgent();
    }
  })();
</script>
