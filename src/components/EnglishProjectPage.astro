---
import Layout from '../layouts/Layout.astro';
import TriviumArtwork from './TriviumArtwork.astro';
import InfosArtwork from './InfosArtwork.astro';
import PiariumArtwork from './PiariumArtwork.astro';
import { projectDetails } from '../data/english';
interface Props { slug: keyof typeof projectDetails }
const { slug } = Astro.props;
const project = projectDetails[slug];
const Artwork = project.kind === 'trivium' ? TriviumArtwork : project.kind === 'infos' ? InfosArtwork : PiariumArtwork;
---

<Layout
  locale="en"
  title={`${project.name} · ${project.title} — Astrmira`}
  description={project.description}
  route={`projects/${slug}`}
>
  <div class="wrap">
    <section class="page-title">
      <div class="breadcrumb"><a href="/en/" data-route="home">Home</a><span>/</span><a href="/en/projects/" data-route="projects">Projects</a><span>/</span><span>{project.name}</span></div>
      <p class="eyebrow">{project.eyebrow}</p>
      <h1>{project.name}</h1>
      <p class="product-tagline">{project.title}</p>
      <p>{project.description}</p>
      <div class="product-actions">
        <a class="button button-primary" href={project.repository} target="_blank" rel="noopener noreferrer">View on GitHub <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${project.repository}#readme`} target="_blank" rel="noopener noreferrer">Read the documentation <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <article class="article-layout">
      <aside class="article-aside">
        <p class="eyebrow">OPEN SOURCE</p>
        <p>{project.name}<br />{project.license} license</p>
        <div class="topic-list">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div>
      </aside>
      <div class="article-content">
        {project.sections.map((section, index) => <>
          <h2>{section.title}</h2>
          {'paragraphs' in section && section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
          {index === 0 && <figure class="product-model"><Artwork decorative={false} /><figcaption>{project.figure}</figcaption></figure>}
          {'features' in section && section.features && <div class="product-features">
            {section.features.map(([label, title, body]) => <section><p class="eyebrow">{label}</p><h3>{title}</h3><p>{body}</p></section>)}
          </div>}
        </>)}
        <div class="product-links">
          <a class="button" href={`${project.repository}/releases`} target="_blank" rel="noopener noreferrer">View releases <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="text-link" href="/en/collaborate/" data-route="collaborate">Discuss an application or collaboration <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .page-title .product-tagline { margin-top: 28px; color: var(--text); font-size: clamp(21px, 2.3vw, 30px); line-height: 1.55; max-width: 820px; }
  .product-tagline + p { margin-top: 18px; }
  .product-actions, .product-links { display: flex; flex-wrap: wrap; align-items: center; gap: 22px 32px; margin-top: 30px; }
  .product-model { margin: 34px 0 48px; padding: 20px 24px 24px; border: 1px solid var(--line); background: #10162080; }
  .product-model :global(svg) { width: min(100%, 490px); margin-inline: auto; }
  .product-model figcaption { color: var(--muted); font-size: 12px; text-align: center; margin-top: 12px; }
  .product-features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; margin: 24px 0 42px; }
  .product-features section { padding: 24px 0; border-top: 1px solid var(--line); }
  .product-features .eyebrow { color: var(--gold); font-size: 9px; }
  .product-features h3 { margin: 12px 0 10px; font-size: 18px; }
  .product-features p { margin: 0; }
  .product-links { padding-top: 24px; border-top: 1px solid var(--line); }
  .product-links .button { margin-top: 0; }
  @media(max-width: 720px) { .product-features { grid-template-columns: 1fr; } .product-model { padding: 12px 14px 20px; } }
</style>
