---
import Layout from '../../layouts/Layout.astro';
import PaperCard from '../PaperCard.astro';
import { papers } from '../../data/papers';
import { getContent } from '../../i18n/content';
import { localePath, type InternationalLocale } from '../../i18n';
interface Props { locale: InternationalLocale }
const { locale } = Astro.props;
const { researchPage: copy, ui } = getContent(locale);
const href = (path: string) => localePath(path, locale);
---
<Layout locale={locale} title={copy.title} description={copy.description} route="research">
  <div class="wrap">
    <section class="page-title"><p class="eyebrow">{copy.label}</p><h1>{copy.heading[0]}<br /><em>{copy.heading[1]}</em></h1><p>{copy.introduction}</p></section>
    <section class="directory-content" data-research-directory aria-label={ui.research.label}>
      <div class="directory-toolbar"><div class="filters" aria-label={ui.research.filter}>{(['all', 'vectors', 'llms', 'theory'] as const).map(key => <button class="filter-button" data-research-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>{ui.research[key]}</button>)}</div><input class="research-search" data-research-search placeholder={ui.research.search} type="search" aria-label={ui.research.search} /></div>
      <div class="publication-grid">{papers.map(paper => <PaperCard paper={paper} headingLevel="h2" locale={locale} />)}</div>
      <p class="empty-search" data-empty-search hidden>{ui.research.empty}</p><p class="publication-count" data-research-count aria-live="polite">{ui.research.count.replace('{count}', String(papers.length))}</p>
    </section>
    <section class="research-contact"><p>{copy.question}</p><a class="text-link" href={href('/collaborate/')} data-route="collaborate">{copy.contact}<span class="arrow" aria-hidden="true">↗</span></a></section>
  </div>
</Layout>
