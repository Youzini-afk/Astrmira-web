---
import Layout from '../../layouts/Layout.astro';
import PaperCarousel from '../PaperCarousel.astro';
import ProjectCard from '../ProjectCard.astro';
import OriginArtwork from '../OriginArtwork.astro';
import { getContent } from '../../i18n/content';
import { localePath, type InternationalLocale } from '../../i18n';
interface Props { locale: InternationalLocale }
const { locale } = Astro.props;
const { home: copy, ui, fields } = getContent(locale);
const href = (path: string) => localePath(path, locale);
const colours = ['#c5ab81', '#719dc4', '#9dbbd6'];
const strands = Array.from({ length: 72 }, (_, index) => {
  const offset = (index - 36) * 2.2;
  return { route: index === 36, colour: colours[(index * 7) % colours.length], opacity: .025 + ((index * 37) % 75) / 1000, width: .3 + ((index * 53) % 120) / 100,
    d: `M${(-100 + offset).toFixed(1)} ${(720 + offset).toFixed(1)} C${(140 + offset).toFixed(1)} ${(475 + offset).toFixed(1)}, ${(370 + offset).toFixed(1)} ${(815 + offset).toFixed(1)}, ${(698 + offset).toFixed(1)} ${(474 + offset / 3).toFixed(1)} S${(993 + offset / 3).toFixed(1)} ${(139 + offset / 2).toFixed(1)}, 1125 202` };
});
---
<Layout locale={locale} title={copy.title} description={copy.description} route="home">
  <section class="hero" data-star-anchor="hero">
    <svg class="hero-sky" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs><radialGradient id="skyglow"><stop stop-color="#8dabc3" stop-opacity=".1" /><stop offset="1" stop-color="#8dabc3" stop-opacity="0" /></radialGradient></defs>
      <ellipse cx="1050" cy="240" rx="300" ry="220" fill="url(#skyglow)" />
      <g stroke="#94b1ce" fill="none"><ellipse cx="720" cy="350" rx="580" ry="235" transform="rotate(-22 720 350)" stroke-opacity=".075" stroke-width=".6" /><ellipse cx="740" cy="360" rx="550" ry="240" transform="rotate(-22 740 360)" stroke-opacity=".07" stroke-width=".6" stroke-dasharray="1 9" /><ellipse cx="740" cy="360" rx="490" ry="190" transform="rotate(-22 740 360)" stroke-opacity=".09" stroke-width=".5" /></g>
      <g data-star-tail opacity="0" stroke-dasharray="1" stroke-dashoffset="1">{strands.map(strand => <path data-star-route={strand.route ? '' : undefined} d={strand.d} stroke={strand.colour} stroke-opacity={strand.opacity} stroke-width={strand.width} fill="none" />)}</g>
    </svg>
    <div class="coordinates hero-particle-mode" lang="en"><span class="coord-star" data-coordinate-line>ο CETI / MIRA</span><span class="coord-line" data-coordinate-line>THE WONDERFUL STAR</span><span class="coord-line" data-coordinate-line>ARTISTIC INTERPRETATION</span></div>
    <div class="hero-copy hero-particle-mode">
      <div class="hero-text-stage"><p class="hero-kicker">{copy.kicker} <span style="color:var(--faint)">/</span> ASTRMIRA</p><h1 lang="en">Astr<em>mira</em></h1><p class="hero-subtitle">{copy.subtitle}</p><p class="hero-english">{copy.supporting}</p><p class="hero-description">{copy.introduction[0]}<br />{copy.introduction[1]}</p></div>
      <div class="hero-actions"><a href={href('/research/')} data-route="research" class="button button-primary">{copy.explore}<span class="arrow" aria-hidden="true">↗</span></a><a href="#projects" class="button button-quiet">{copy.discover}<span aria-hidden="true">↓</span></a></div>
    </div>
    <div class="hero-bottom"><a href="#practice" class="scroll-cue">{ui.motion.scroll}</a><div class="motion-controls"><span class="phase-label">MIRA</span><button data-replay aria-label={ui.motion.replayLabel}>↺ {ui.motion.replay}</button><button data-motion-toggle aria-pressed="false"><span class="motion-dot"></span><span data-motion-text>{ui.motion.pause}</span></button></div></div>
  </section>
  <div class="domains-strip"><div class="wrap domains-inner">{Object.values(fields).map(([name], index) => <>{index > 0 && <i aria-hidden="true">✧</i>}<span>{name}</span></>)}</div></div>
  <section id="practice" class="wrap manifesto"><p class="eyebrow">{copy.researchLabel}</p><div><h2 class="statement">{copy.researchHeading[0]}<br /><span>{copy.researchHeading[1]}</span></h2><p class="statement-note">{copy.researchNote}</p></div></section>
  <section id="principles" class="wrap projects-section"><div class="section-heading"><div><p class="eyebrow">{copy.papersLabel}</p><h2>{copy.papersHeading[0]}<br /><em>{copy.papersHeading[1]}</em></h2><p class="sub">{copy.papersNote}</p></div><a href={href('/research/')} data-route="research" class="text-link">{copy.allResearch}<span class="arrow" aria-hidden="true">↗</span></a></div><PaperCarousel locale={locale} /></section>
  <section class="wrap manifesto"><p class="eyebrow">{copy.practiceLabel}</p><div><h2 class="statement">{copy.practiceHeading[0]}<br /><span>{copy.practiceHeading[1]}</span></h2><p class="statement-note">{copy.practiceNote}</p></div></section>
  <section id="projects" class="wrap projects-section"><div class="section-heading"><div><p class="eyebrow">{copy.projectsLabel}</p><h2>{copy.projectsHeading[0]}<br /><em>{copy.projectsHeading[1]}</em></h2><p class="sub">{copy.projectsNote}</p></div><a href={href('/projects/')} data-route="projects" class="text-link">{ui.projects.all}<span class="arrow" aria-hidden="true">↗</span></a></div><div class="project-grid"><ProjectCard project="trivium" locale={locale} /><ProjectCard project="infos" locale={locale} /><ProjectCard project="piarium" locale={locale} /></div></section>
  <section class="wrap origin-section" data-star-anchor="origin"><OriginArtwork /><div class="origin-copy"><p class="eyebrow">{copy.nameLabel}</p><h2>{copy.nameHeading[0]}<br /><em>{copy.nameHeading[1]}</em></h2><p class="origin-cn">{copy.nameMotto}</p><p>{copy.nameStory}</p><p style="margin-top:13px">{copy.nameMeaning}</p><a class="source" href="https://apod.nasa.gov/apod/ap070817.html" target="_blank" rel="noopener noreferrer">{copy.nameSource} ↗</a></div></section>
  <section class="wrap"><div class="collaborate-block"><div><p class="eyebrow" style="margin-bottom:18px">{copy.ctaLabel}</p><h2>{copy.ctaHeading[0]}<br />{copy.ctaHeading[1]}</h2><p>{copy.ctaText}<br />{copy.ctaNote}</p></div><a href={href('/collaborate/')} data-route="collaborate" class="button button-primary">{copy.cta}<span class="arrow" aria-hidden="true">↗</span></a></div></section>
</Layout>
