---
import Layout from '../../layouts/Layout.astro';
import TriviumArtwork from '../TriviumArtwork.astro';
import InfosArtwork from '../InfosArtwork.astro';
import VarinArtwork from '../VarinArtwork.astro';
import WorkbenchGlyph from '../WorkbenchGlyph.astro';
import { getContent, getUi } from '../../i18n/content';
import { varinChinese } from '../../data/projects-zh';
import { localePath, type Locale } from '../../i18n';
interface Props { slug: 'data-systems' | 'agent-platform' | 'varin'; locale: Locale }
const { slug, locale } = Astro.props;
// Simplified Chinese keeps hand-written pages for the older projects; Varin uses
// this template in every language.
const project: any = locale === 'zh-cn' ? varinChinese : getContent(locale).projectDetails[slug];
const ui = getUi(locale);
const href = (path: string) => localePath(path, locale);
const Artwork = project.kind === 'trivium' ? TriviumArtwork : project.kind === 'infos' ? InfosArtwork : VarinArtwork;
const readme = project.readmes?.[locale] ?? `${project.repository}#readme`;
// Mentions of TriviumDB inside another project's copy link to its page.
const linked = (text: string) => slug === 'data-systems' ? [text] : text.split(/(TriviumDB)/);
---

<Layout
  locale={locale}
  title={`${project.name} · ${project.title} — Astrmira`}
  description={project.description}
  route={`projects/${slug}`}
>
  <div class="wrap">
    <section class="page-title">
      <div class="breadcrumb"><a href={href('/')} data-route="home">{ui.nav.home}</a><span>/</span><a href={href('/projects/')} data-route="projects">{ui.nav.projects}</a><span>/</span><span>{project.name}</span></div>
      <p class="eyebrow">{project.eyebrow}</p>
      <h1>{project.name}</h1>
      <p class="product-tagline">{project.title}</p>
      <p>{project.description}</p>
      <div class="product-actions">
        <a class="button button-primary" href={project.repository} target="_blank" rel="noopener noreferrer">{ui.common.github} <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="text-link" href={readme} target="_blank" rel="noopener noreferrer">{ui.common.documentation} <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <article class="article-layout">
      <aside class="article-aside">
        <p class="eyebrow">{ui.common.openSource}</p>
        <p>{project.name}<br />{project.license === 'Open source' ? ui.common.openSource : `${project.license} · ${ui.common.license}`}{project.status && <><br />{project.status}</>}</p>
        <div class="topic-list">{project.tags.map((tag: string) => <span class="tag">{tag}</span>)}</div>
      </aside>
      <div class="article-content">
        {project.sections.map((section: any, index: number) => <>
          <h2>{section.title}</h2>
          {section.paragraphs?.map((paragraph: string) => <p>{linked(paragraph).map(part => part === 'TriviumDB' ? <a class="inline-project-link" href={href('/projects/data-systems/')} data-route="projects/data-systems">TriviumDB</a> : part)}</p>)}
          {index === 0 && <figure class="product-model"><Artwork decorative={false} label={project.figure} /><figcaption>{project.figure}</figcaption></figure>}
          {section.features && <div class="product-features">
            {section.features.map(([label, title, body]: string[]) => <section><p class="eyebrow">{label}</p><h3>{title}</h3><p>{body}</p></section>)}
          </div>}
          {section.workbenches && <ul class="workbench-list">
            {section.workbenches.map(([name, text, platforms]: string[], i: number) => <li>
              <WorkbenchGlyph kind={i} />
              <p class="workbench-name" lang="en">{name}</p>
              <p>{text}</p>
              <p class="workbench-platforms">{platforms}</p>
            </li>)}
          </ul>}
          {section.start && <ul class="start-list">
            {section.start.map(([label, title, text, action]: string[], i: number) => <li>
              <a href={project.startLinks[i]} target="_blank" rel="noopener noreferrer">
                <span class="start-label">{label}</span>
                <span class="start-title">{title}</span>
                <span class="start-text">{text}</span>
                <span class="start-action">{action}<span aria-hidden="true">↗</span></span>
              </a>
            </li>)}
          </ul>}
        </>)}
        <div class="product-links">
          <a class="button" href={`${project.repository}/releases`} target="_blank" rel="noopener noreferrer">{ui.common.releases} <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="text-link" href={href('/collaborate/')} data-route="collaborate">{ui.common.discuss} <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .page-title .product-tagline { margin-top: 28px; color: var(--text); font-size: clamp(21px, 2.3vw, 30px); line-height: 1.55; max-width: 820px; }
  .product-tagline + p { margin-top: 18px; }
  .product-actions, .product-links { display: flex; flex-wrap: wrap; align-items: center; gap: 22px 32px; margin-top: 30px; }
  .product-model { margin: 34px 0 48px; padding: 20px 24px 24px; border: 1px solid var(--line); border-radius: var(--radius-panel); background: #10162080; }
  .product-model :global(svg) { width: min(100%, 490px); margin-inline: auto; }
  .product-model figcaption { color: var(--muted); font-size: 12px; text-align: center; margin-top: 12px; }
  .product-features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; margin: 24px 0 42px; }
  .product-features section { padding: 24px 0; border-top: 1px solid var(--line); }
  .product-features .eyebrow { color: var(--gold); font-size: 9px; }
  .product-features h3 { margin: 12px 0 10px; font-size: 18px; }
  .product-features p { margin: 0; }
  .inline-project-link { color: var(--gold); border-bottom: 1px solid var(--line); }
  /* A section that ends in prose needs the same air before the next heading as one ending in a grid. */
  .article-content p + h2 { margin-top: 46px; }
  /* Workbenches: four small window sketches that share one row. */
  .workbench-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin: 28px 0 46px; padding: 0; list-style: none; }
  .workbench-list li { display: flex; flex-direction: column; padding: 18px 18px 20px; border: 1px solid var(--line); border-radius: var(--radius-panel); background: #10162080; }
  .workbench-list :global(.workbench-glyph) { width: 100%; height: auto; margin-bottom: 18px; }
  .workbench-list p { margin: 0; font-size: 14px; line-height: 1.8; }
  .workbench-list .workbench-name { margin: 0 0 8px; font: 400 22px/1.3 var(--serif); color: var(--text); }
  .workbench-list .workbench-platforms { margin-top: auto; padding-top: 14px; color: var(--faint); font-size: 12px; line-height: 1.8; }
  /* Start here: each entry is one link to the matching guide. */
  .start-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 26px 0 44px; padding: 0; list-style: none; }
  .start-list a { display: flex; flex-direction: column; height: 100%; padding: 22px 22px 20px; border: 1px solid var(--line); border-radius: var(--radius-panel); background: #0e131bcc; transition: border-color .25s, background-color .25s; }
  .start-label { color: var(--gold); font: 10px/1.8 var(--mono); letter-spacing: .1em; }
  .start-title { margin: 10px 0 8px; color: var(--text); font-size: 18px; line-height: 1.5; }
  .start-text { color: var(--muted); font-size: 14px; line-height: 1.8; }
  .start-action { display: inline-flex; align-items: center; gap: 10px; margin-top: auto; padding-top: 18px; color: var(--text); font-size: 13px; }
  .start-action span { color: var(--gold); transition: transform .2s var(--ease-ui); }
  .start-list a:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .start-list a:hover { border-color: #d6b88155; background: #121822dd; }
    .start-list a:hover .start-action span { transform: translate(2px, -2px); }
  }
  .product-links { padding-top: 24px; border-top: 1px solid var(--line); }
  .product-links .button { margin-top: 0; }
  @media (max-width: 1100px) { .workbench-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) {
    .product-features, .start-list { grid-template-columns: 1fr; }
    .product-model { padding: 12px 14px 20px; }
    .workbench-list { gap: 12px; }
    .workbench-list li { padding: 14px 14px 16px; }
    .workbench-list .workbench-name { font-size: 20px; }
    .workbench-list p { font-size: 13px; }
  }
  @media (max-width: 340px) { .workbench-list { grid-template-columns: 1fr; } }
  :global(html.is-paused) .start-list a, :global(html.is-paused) .start-action span { transition: none; }
</style>
