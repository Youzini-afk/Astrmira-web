---
import Layout from '../../layouts/Layout.astro';
import PaperArtwork from '../PaperArtwork.astro';
import PaperCard from '../PaperCard.astro';
import { papers, arxivUrl, type Paper } from '../../data/papers';
import { getContent } from '../../i18n/content';
import { localePath, type InternationalLocale } from '../../i18n';
interface Props { slug: string; locale: InternationalLocale }
const { slug, locale } = Astro.props;
const paper = papers.find(p => p.slug === slug)!;
const content = getContent(locale), ui = content.ui;
const copy = content.papers[slug];
const href = (path: string) => localePath(path, locale);
const related = paper.related.map(slug => papers.find(item => item.slug === slug)).filter(Boolean) as Paper[];
const pdf = `https://arxiv.org/pdf/${paper.arxiv}${paper.version}`;
---

<Layout locale={locale} title={`${locale === 'en' ? paper.title : copy.heading} — Astrmira`} description={copy.summary} route={`research/papers/${paper.slug}`}>
  <div class="wrap">
    <section class="page-title paper-title">
      <div class="breadcrumb"><a href={href('/')} data-route="home">{ui.nav.home}</a><span>/</span><a href={href('/research/')} data-route="research">{ui.nav.research}</a><span>/</span><span>{paper.arxiv}</span></div>
      <p class="eyebrow">{paper.category} / ARXIV:{paper.arxiv}</p>
      <h1>{locale === 'en' ? paper.title : copy.heading}</h1>
      {locale !== 'en' && <p class="original-title" lang="en">{paper.title}</p>}
      <p class="paper-lede">{copy.summary}</p>
      <div class="product-actions"><a class="button button-primary" href={arxivUrl(paper)} target="_blank" rel="noopener noreferrer">{ui.paper.arxiv}<span class="arrow" aria-hidden="true">↗</span></a><a class="text-link" href={pdf} target="_blank" rel="noopener noreferrer">{ui.paper.pdf}<span class="arrow" aria-hidden="true">↗</span></a></div>
    </section>
    <article class="article-layout">
      <aside class="article-aside">
        <p class="eyebrow">{ui.paper.details}</p>
        <dl class="paper-meta"><dt>{ui.paper.authors}</dt><dd lang="en">{paper.authors.join(', ')}</dd><dt>{ui.paper.submitted}</dt><dd><time datetime={paper.submitted}>{paper.submitted}</time></dd><dt>{ui.paper.revised}</dt><dd><time datetime={paper.updated}>{paper.updated}</time></dd><dt>{ui.paper.version}</dt><dd>arXiv {paper.arxiv}{paper.version}</dd></dl>
        <div class="topic-list">{copy.tags.map(tag => <span class="tag">{tag}</span>)}</div>
      </aside>
      <div class="article-content">
        <figure class="paper-figure"><PaperArtwork kind={paper.artwork} /><figcaption>{copy.caption}</figcaption></figure>
        {copy.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}
        <section class="source-note"><p class="eyebrow">{ui.paper.readCite}</p><h2>{ui.paper.continue}</h2><p>{ui.paper.original}</p><p><a class="text-link" href={arxivUrl(paper)} target="_blank" rel="noopener noreferrer">{ui.paper.versions} ↗</a><br /><a class="text-link" href={pdf} target="_blank" rel="noopener noreferrer">{ui.paper.fullPdf} ↗</a></p></section>
      </div>
    </article>
    {related.length > 0 && <section class="related-papers"><p class="eyebrow">{ui.paper.related}</p><div class="related-grid">{related.map(item => <PaperCard paper={item} locale={locale} />)}</div></section>}
  </div>
</Layout>

<style>
  .paper-title h1 { max-width: 1100px; font: 400 clamp(36px, 5vw, 69px)/1.12 var(--serif); letter-spacing: -.025em; text-wrap: balance; }
  .paper-lede { max-width: 900px; margin-top: 25px; }
  .original-title { font: 18px/1.7 var(--serif); color: var(--muted); }
  .product-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px 32px; margin-top: 30px; }
  .paper-meta { margin: 22px 0 26px; }
  .paper-meta dt { margin-top: 17px; color: var(--faint); font: 9px var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .paper-meta dd { margin: 6px 0 0; color: var(--muted); font-size: 12px; line-height: 1.75; }
  .paper-figure { margin: 0 0 48px; padding: 18px 22px 22px; border: 1px solid var(--line); background: #10162080; }
  .paper-figure :global(svg) { width: min(100%, 620px); margin-inline: auto; }
  .paper-figure figcaption { margin-top: 12px; color: var(--muted); font-size: 12px; text-align: center; }
  .article-content section + section { margin-top: 48px; }
  .source-note { margin-top: 58px; padding-top: 30px; border-top: 1px solid var(--line); }
  .source-note .eyebrow { color: var(--gold); }
  .related-papers { padding: 20px 0 95px; border-top: 1px solid var(--line); }
  .related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 360px)); gap: 32px; margin-top: 25px; }
  @media(max-width:720px){.related-grid{grid-template-columns:minmax(0,360px);justify-content:center}.paper-figure{padding:12px 14px 20px}}
</style>
