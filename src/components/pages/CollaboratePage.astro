---
import Layout from '../../layouts/Layout.astro';
import { getContent } from '../../i18n/content';
import type { InternationalLocale } from '../../i18n';
interface Props { locale: InternationalLocale }
const { locale } = Astro.props;
const { collaborate: copy, ui } = getContent(locale);
const form = ui.form;
---
<Layout locale={locale} title={copy.title} description={copy.description} route="collaborate">
  <div class="wrap"><section class="page-title"><p class="eyebrow">{copy.label}</p><h1>{copy.heading[0]}<br /><em>{copy.heading[1]}</em></h1><p>{copy.introduction}</p></section>
    <section class="contact-grid"><div class="contact-side"><h2>{copy.sideTitle}</h2><p>{copy.sideNote}</p><div class="contact-aspects">{copy.aspects.map(aspect => <div><span>{aspect}</span></div>)}</div></div>
      <form class="contact-form" data-brief-form>
        <div class="form-grid"><div class="field"><label for="contact-name">{form.name}</label><input id="contact-name" name="name" placeholder={form.namePlaceholder} maxlength="100" autocomplete="name" /></div><div class="field"><label for="contact-org">{form.organization}</label><input id="contact-org" name="organization" placeholder={form.organizationPlaceholder} maxlength="180" autocomplete="organization" /></div></div>
        <div class="field"><label for="contact-area">{form.area}</label><select id="contact-area" name="area">{form.areas.map(area => <option>{area}</option>)}</select></div>
        <div class="field"><label for="contact-problem">{form.problem}</label><textarea id="contact-problem" name="problem" placeholder={form.placeholder} required minlength="8" maxlength="5000"></textarea></div>
        <div class="form-actions"><button type="submit" class="button button-primary">{form.submit}<span class="arrow" aria-hidden="true">↗</span></button><span class="tiny-note">{form.note}</span></div>
        <div class="brief-result" data-brief-result hidden><h3>{form.result}</h3><pre data-brief-text></pre><div class="brief-actions"><button class="button" type="button" data-copy-brief>{form.copy}</button><button class="button" type="button" data-download-brief>{form.download} ↓</button></div><p class="tiny-note" data-brief-status role="status" style="margin-top:13px">{form.generated}</p></div>
      </form>
    </section>
  </div>
</Layout>
